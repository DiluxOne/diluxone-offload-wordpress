# Files and directories listed here are excluded from the wp.org SVN deploy
# (10up/action-wordpress-plugin-deploy reads this file, gitignore-style format).
# They live in the GitHub repo but never reach the published plugin.

# Repo metadata
.git
.github
.gitignore
.gitattributes
.distignore
.editorconfig

# wp.org listing assets — handled separately by the deploy action (uploaded to
# SVN /assets/, not /trunk/). Excluding it here prevents duplication in /trunk/.
.wordpress-org

# Documentation (GitHub-only)
README.md
CONTRIBUTING.md
SECURITY.md
AGENTS.md
CLAUDE.md
docs

# Dev dependencies
node_modules
vendor
package.json
package-lock.json
composer.json
composer.lock

# Dev environment
.wp-env.json
.wp-env.override.json

# Linters / static analysis configuration and caches
phpcs.xml
phpcs.xml.dist
.phpcs-cache
phpstan.neon
phpstan.neon.dist
phpstan-baseline.neon
phpstan-bootstrap.php
.phpstan
psalm.xml
psalm.xml.dist
psalm-baseline.xml
.psalm

# End-to-end test runner configuration (the specs live in tests/)
playwright.config.ts
playwright.real.config.ts
playwright.screenshots.config.ts

# Local secrets for the real-storage suite: never in a build, whatever its name
.env
.env.*

# Tests and test artifacts
phpunit.xml
phpunit.xml.dist
phpunit-integration.xml
phpunit-integration.xml.dist
tests
.phpunit.cache
coverage
coverage.xml
clover.xml

# Build / dev tooling
Makefile
tools
bin
scripts

# IDE
.idea
.vscode

# Bundled translations are never loaded from the plugin folder (load_plugin_textdomain()
# is discouraged for directory-hosted plugins); the .pot stays, the .po/.mo are for
# translate.wordpress.org once the plugin is published.
languages/*.po
languages/*.mo

# Build artifacts and logs
build
*.zip
*.log
*.tar
*.tar.gz
