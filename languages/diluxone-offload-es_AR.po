msgid "Unauthorized"
msgstr "No autorizado."

#: includes/class-diluxone-offload-admin.php:1899
msgid "You must test the connection first"
msgstr "Primero tenés que probar la conexión."

#: includes/class-diluxone-offload-admin.php:1911
msgid "Credentials do not match tested values. Please test again."
msgstr ""
"Las credenciales no coinciden con los valores probados. Probá la conexión "
"nuevamente."

#: includes/class-diluxone-offload-admin.php:1933
msgid "Credentials were not saved: the provider configuration is invalid."
msgstr ""
"No se guardaron las credenciales: la configuración del proveedor no es "
"válida."

#: includes/class-diluxone-offload-admin.php:1968
#: includes/class-diluxone-offload-admin.php:2043
#: includes/class-diluxone-offload-admin.php:2100
msgid "Invalid nonce"
msgstr "Nonce no válido."

#: includes/class-diluxone-offload-admin.php:1989
msgid "Cannot cancel sync: Another tab is currently syncing"
msgstr ""
"No se puede cancelar la sincronización: Otra pestaña está sincronizando "
"actualmente"

#: includes/class-diluxone-offload-admin.php:2005
msgid "Sync cancelled successfully"
msgstr "Sincronización cancelada correctamente"

