#. translators: %d: number of days
#: includes/class-diluxone-offload-admin.php:1558
#, php-format
msgid "%d day ago"
msgid_plural "%d days ago"
msgstr[0] "hace %d día"
msgstr[1] "hace %d días"

#. translators: %s: human-readable time, e.g. "5 minutes ago"
#: includes/class-diluxone-offload-admin.php:1576
#, php-format
msgid "Last successful connection: %s"
msgstr "Última conexión exitosa: %s"

#: includes/class-diluxone-offload-admin.php:1582
#: templates/admin-overview.php:218 templates/admin-status-health.php:193
msgid "New uploads are refused until the connection recovers."
msgstr "Las subidas nuevas se rechazan hasta que la conexión se recupere."

#: includes/class-diluxone-offload-admin.php:1641
#: includes/class-diluxone-offload-admin.php:1742
msgid "Security check failed"
msgstr "Falló la verificación de seguridad."

#: includes/class-diluxone-offload-admin.php:1646
#: includes/class-diluxone-offload-admin.php:1747
#: includes/class-diluxone-offload-admin.php:1857
#: includes/class-diluxone-offload-admin.php:1972
