#. translators: 1: files processed, 2: files in all
#, php-format
msgid "%1$s / %2$s files"
msgstr "%1$s / %2$s archivos"

#. translators: 1: number of files deleted, 2: number that could not be, 3:
#. the first error
#, php-format
msgid "%1$s deleted, %2$s could not be (%3$s). Nothing else was touched; try again, or continue with what is left."
msgstr "%1$s borrados, %2$s no se pudieron borrar (%3$s). No se tocó nada más; se puede reintentar o seguir con lo que quedó."

#. translators: 1: number of files, 2: their total size, 3: the folder (e.g.
#. uploads/), 4: the container or bucket
#, php-format
msgid "%1$s file (%2$s) already sits under %3$s in %4$s, where this site's media goes."
msgstr "Ya hay %1$s archivo (%2$s) en %3$s de %4$s, donde van los medios de este sitio."

#. translators: 1: number of files, 2: how long ago the scan ran
#, php-format
msgid "%1$s file was left out by the last scan (%2$s)."
msgid_plural "%1$s files were left out by the last scan (%2$s)."
msgstr[0] "%1$s archivo quedó afuera en el último escaneo (%2$s)."
msgstr[1] "%1$s archivos quedaron afuera en el último escaneo (%2$s)."

#. translators: 1: number of files, 2: their total size, 3: the folder (e.g.
#. uploads/), 4: the container or bucket
#, php-format
msgid "%1$s files (%2$s) already sit under %3$s in %4$s, where this site's media goes."
msgstr "Ya hay %1$s archivos (%2$s) en %3$s de %4$s, donde van los medios de este sitio."

#. translators: 1: number of files synced, 2: where they are, 3: number of
#. files that still have a local copy
#, php-format
msgid "%1$s files synced to %2$s; %3$s still have a copy on this server."
msgstr "%1$s archivos sincronizados en %2$s; %3$s todavía tienen una copia en este servidor."

#. translators: 1: number of files synced, 2: where they are
#, php-format
msgid "%1$s files synced to %2$s; still served from this server until offloading is enabled."
msgstr "%1$s archivos sincronizados en %2$s; se siguen sirviendo desde este servidor hasta que se active el offloading."

#. translators: 1: files in the cloud, 2: files in the library, 3: percentage
#, php-format
msgid "%1$s of %2$s · %3$s%%"
msgstr "%1$s de %2$s · %3$s%%"

#. translators: 1: files only in the cloud, 2: files also on this server
#, php-format
msgid "%1$s only in the cloud, %2$s also on this server"
msgstr "%1$s solo en la nube, %2$s también en este servidor"

#. translators: 1: plugin name, 2: name of the screen
#, php-format
msgctxt "a dashboard screen title"
msgid "%1$s | %2$s"
msgstr "%1$s | %2$s"

#. translators: 1: what the value is (e.g. "Container"), 2: the value
#, php-format
msgid "%1$s: <strong>%2$s</strong>"
msgstr "%1$s: <strong>%2$s</strong>"

#. translators: %d: number of days
#, php-format
msgid "%d day ago"
msgid_plural "%d days ago"
msgstr[0] "hace %d día"
msgstr[1] "hace %d días"

#. translators: %d: number of files
#, php-format
msgid "%d file was added since the last sync: it has to be uploaded before offloading is enabled."
msgid_plural "%d files were added since the last sync: they have to be uploaded before offloading is enabled."
msgstr[0] "Se agregó %d archivo desde la última sincronización: hay que subirlo antes de activar la descarga."
msgstr[1] "Se agregaron %d archivos desde la última sincronización: hay que subirlos antes de activar la descarga."

#. translators: %d: number of files that failed to sync
#, php-format
msgid "%d files failed to sync"
msgstr "%d archivos fallaron al sincronizar"

#. translators: %d: number of hours
#, php-format
msgid "%d hour ago"
msgid_plural "%d hours ago"
msgstr[0] "hace %d hora"
msgstr[1] "hace %d horas"

#. translators: %d: number of minutes
#, php-format
msgid "%d minute ago"
msgid_plural "%d minutes ago"
msgstr[0] "hace %d minuto"
msgstr[1] "hace %d minutos"

#. translators: %s: a human time difference, e.g. "10 minutes"
#, php-format
msgid "%s ago"
msgstr "hace %s"

#. translators: %s: number of rows in the plugin's tracking table
#, php-format
msgid "%s file tracked"
msgid_plural "%s files tracked"
msgstr[0] "%s archivo registrado"
msgstr[1] "%s archivos registrados"

msgid "(uploads refused from 3)"
msgstr "(las subidas se rechazan a partir de 3)"

msgid "(what a disconnect can bring back)"
msgstr "(lo que una desconexión puede traer de vuelta)"

msgid "A file that fails is listed with its error and can be retried; the rest of the library is not held back by it."
msgstr "Un archivo que falla queda listado con su error y se puede reintentar; el resto de la biblioteca no se frena por él."

msgid "A new access key is tested against the same account and container or bucket before it replaces the saved one; the media in the cloud is not touched."
msgstr "Una clave de acceso nueva se prueba contra la misma cuenta y el mismo contenedor o bucket antes de reemplazar la guardada; los medios en la nube no se tocan."

msgid "A previous synchronization was interrupted. You can continue from where it left off or start fresh."
msgstr "Una sincronización anterior fue interrumpida. Podés continuar desde donde se quedó o comenzar de nuevo."

msgid "A rotation usually gives a new pair: change it if yours did."
msgstr "Una rotación suele dar un par nuevo: cambialo si el tuyo cambió."

msgid "A sync has run since, so what is there is this site's media; nothing was deleted."
msgstr "Ya hubo una sincronización, así que lo que hay son medios de este sitio; no se borró nada."

#. translators: 1: number of files synced so far, 2: number of files pending
#, php-format
msgid "A sync is in progress: %1$s files done, %2$s pending."
msgstr "Hay una sincronización en curso: %1$s archivos listos, %2$s pendientes."

#. translators: %d: the Transfer Timeout setting, in seconds
#, php-format
msgid "A transfer to the cloud took longer than allowed: the Transfer Timeout (%d seconds) for an upload, at least 300 seconds for a download. Raise the setting if this host or its connection is slow; if transfers used to work at this value, check the connection to the provider."
msgstr "Una transferencia a la nube tardó más de lo permitido: el tiempo de espera de transferencia (%d segundos) para una subida, al menos 300 segundos para una descarga. Subí el ajuste si este servidor o su conexión son lentos; si las transferencias funcionaban con este valor, revisá la conexión con el proveedor."

msgid "ALL sync progress will be discarded (including successfully uploaded files)"
msgstr "TODO el progreso de sincronización será descartado (incluyendo archivos cargados exitosamente)"

msgid "AWS console › IAM › Users › Security credentials › Create access key, for a user allowed to put, get, delete and list objects in the bucket. The bucket must allow anonymous read of objects (Block Public Access off and a bucket policy granting s3:GetObject); Test Connection checks it."
msgstr "Consola de AWS › IAM › Users › Security credentials › Create access key, para un usuario con permiso para poner, obtener, borrar y listar objetos en el bucket. El bucket tiene que permitir la lectura anónima de objetos (Block Public Access desactivado y una bucket policy que otorgue s3:GetObject); Probar conexión lo comprueba."

msgid "Accept"
msgstr "Aceptar"

msgid "Access Key ID"
msgstr "ID de clave de acceso"

msgid "Account Key"
msgstr "Clave de cuenta"

msgid "Actions"
msgstr "Acciones"

msgid "Activate offloading to serve all media files directly from cloud storage. New uploads will go straight to the cloud, saving local disk space."
msgstr "Activar descarga para servir todos los archivos multimedia directamente desde el almacenamiento en la nube. Las nuevas cargas irán directamente a la nube, ahorrando espacio en disco local."

msgid "Active"
msgstr "Activo"

msgid "Addressing"
msgstr "Direccionamiento"

msgid "Advanced"
msgstr "Avanzado"

msgid "Akamai (Linode) Object Storage"
msgstr "Akamai (Linode) Object Storage"

msgid "Akamai Cloud Manager › Object Storage › Access Keys, with read and write in the bucket's region. The region is the first part of the bucket's hostname (for example us-east-1 or us-ord-10). Newer endpoints ignore per-object ACLs: let anyone read the bucket with a bucket policy; Test Connection checks it."
msgstr "Akamai Cloud Manager › Object Storage › Access Keys, con lectura y escritura en la región del bucket. La región es la primera parte del nombre de host del bucket (por ejemplo us-east-1 o us-ord-10). Los endpoints nuevos ignoran las ACL por objeto: dejá que cualquiera lea el bucket con una bucket policy; Probar conexión lo comprueba."

#. translators: %d: number of files already synced
#, php-format
msgid "All %d files are synced! Click to scan for any new/modified files and complete the sync process to enable offloading."
msgstr "¡Todos los %d archivos están sincronizados! Hacé clic para escanear cualquier archivo nuevo/modificado y completar el proceso de sincronización para habilitar la descarga."

msgid "All files downloaded and offloading disabled"
msgstr "Todos los archivos descargados y descarga deshabilitada"

msgid "All files have been synced to cloud storage."
msgstr "Todos los archivos se sincronizaron al almacenamiento en la nube."

msgid "All files will be downloaded from cloud to local storage (reverse sync)"
msgstr "Todos los archivos se descargarán de la nube al almacenamiento local (sincronización inversa)"

msgid "All in the cloud only"
msgstr "Todo solo en la nube"

#. translators: %s: number of files that still have a copy on this server
#, php-format
msgid "All in the cloud · %s still has a copy here"
msgid_plural "All in the cloud · %s still have a copy here"
msgstr[0] "Todo en la nube · %s todavía tiene una copia acá"
msgstr[1] "Todo en la nube · %s todavía tienen una copia acá"

msgid "All local files have been deleted."
msgstr "Todos los archivos locales han sido eliminados."

msgid "All sync history will be cleared"
msgstr "Todo el historial de sincronización será borrado"

msgid "All your media files have been uploaded to the cloud. You can now enable offloading to serve files directly from cloud storage."
msgstr "Todos tus archivos multimedia han sido cargados a la nube. Ahora podés habilitar la descarga para servir archivos directamente desde el almacenamiento en la nube."

msgid "Already local:"
msgstr "Ya locales:"

msgid "Already synced files will be detected and skipped"
msgstr "Los archivos ya sincronizados serán detectados y omitidos"

msgid "Already uploaded:"
msgstr "Ya cargados:"

msgid "Amazon S3"
msgstr "Amazon S3"

msgid "An unexpected error occurred while talking to the cloud provider."
msgstr "Hubo un error inesperado al hablar con el proveedor."

msgid "Analyzing Sync Status"
msgstr "Analizando el estado de la sincronización"

msgid "Another browser tab is currently processing the sync."
msgstr "Otra pestaña del navegador está procesando la sincronización."

msgid "Another tab is currently syncing."
msgstr "Otra pestaña está sincronizando."

msgid "Any other server that speaks the S3 API (MinIO, Ceph, …): type the endpoint, the region it expects and the public URL browsers load objects from."
msgstr "Cualquier otro servidor que hable la API de S3 (MinIO, Ceph, …): escribí el endpoint, la región que espera y la URL pública desde la que los navegadores cargan los objetos."

msgid "Applied to every file uploaded from now on. Files already in the cloud keep what they were stored with."
msgstr "Se aplica a cada archivo que se suba de ahora en más. Los archivos que ya están en la nube conservan lo que tenían al guardarse."

msgid "Are you sure you want to clear the failed files list?"
msgstr "¿Estás seguro de que querés limpiar la lista de archivos fallidos?"

msgid "Are you sure you want to delete your cloud storage configuration?"
msgstr "¿Estás seguro de que querés eliminar tu configuración de almacenamiento en la nube?"

msgid "Are you sure you want to resynchronize all files?"
msgstr "¿Estás seguro de que querés resincronizar todos los archivos?"

#. translators: %d: number of files that failed to upload
#, php-format
msgid "Attempt to upload the %d failed files again. Successfully uploaded files remain in cloud storage."
msgstr "Intentar cargar los %d archivos fallidos nuevamente. Los archivos cargados exitosamente permanecen en el almacenamiento en la nube."

msgid "Attempts"
msgstr "Intentos"

msgid "Audio"
msgstr "Audio"

#. translators: 1: number of files, 2: percentage
#, php-format
msgid "Audio %1$s (%2$s%%)"
msgstr "Audio %1$s (%2$s%%)"

msgid "Awaiting Re-entry"
msgstr "Esperando que las vuelvas a ingresar"

msgid "Azure Blob Storage"
msgstr "Azure Blob Storage"

msgid "Azure: portal › your storage account › Access keys. The container must allow anonymous read of blobs (public access level Blob); a private container is refused."
msgstr "Azure: portal › tu cuenta de almacenamiento › Claves de acceso. El contenedor tiene que permitir la lectura anónima de blobs (nivel de acceso público Blob); un contenedor privado se rechaza."

msgid "Backblaze B2"
msgstr "Backblaze B2"

msgid "Backblaze › Application Keys: a key with read and write access to the bucket. The region is in the bucket's S3 endpoint (for example us-west-004). The bucket must be public; Test Connection checks it."
msgstr "Backblaze › Application Keys: una clave con acceso de lectura y escritura al bucket. La región está en el endpoint S3 del bucket (por ejemplo us-west-004). El bucket tiene que ser público; Probar conexión lo comprueba."

msgid "Balanced (5 parallel - Recommended)"
msgstr "Equilibrado (5 en paralelo - Recomendado)"

msgid "Balanced (5 parallel)"
msgstr "Equilibrado (5 en paralelo)"

msgid "Browser caching"
msgstr "Caché del navegador"

msgid "Browsers and CDNs keep the file instead of asking the storage again: fewer requests, faster pages. The default, public, max-age=604800, is one week. A file you replace under the same name may show its old version for that long."
msgstr "Los navegadores y las CDN conservan el archivo en lugar de volver a pedírselo al almacenamiento: menos pedidos, páginas más rápidas. El valor predeterminado, public, max-age=604800, es una semana. Un archivo que reemplaces con el mismo nombre puede mostrar su versión anterior durante ese tiempo."

msgid "Bucket"
msgstr "Bucket"

msgid "Build"
msgstr "Build"

msgid "Cache directories"
msgstr "Directorios de caché"

msgid "Cache-Control value"
msgstr "Valor de Cache-Control"

msgid "Calculating failed files..."
msgstr "Calculando los archivos fallidos..."

msgid "Calculating files to delete..."
msgstr "Calculando archivos a eliminar..."

msgid "Calculating files to sync..."
msgstr "Calculando los archivos a sincronizar..."

msgid "Cancel"
msgstr "Cancelar"

msgid "Cancel Download"
msgstr "Cancelar Descargar"

msgid "Cancel Sync & Reset"
msgstr "Cancelar sincronización y restablecer"

msgid "Cancel sync and return to configured state. This will discard all progress."
msgstr "Cancelar sincronización y volver al estado configurado. Esto descartará todo el progreso."

msgid "Cancel the entire sync process and return to configured state. This will discard ALL progress including successfully uploaded files."
msgstr "Cancelar todo el proceso de sincronización y volver al estado configurado. Esto descartará TODO el progreso incluyendo archivos cargados exitosamente."

msgid "Cancelling download..."
msgstr "Cancelando descarga..."

msgid "Cancelling sync..."
msgstr "Cancelando sincronización..."

msgid "Cancelling sync... Please wait."
msgstr "Cancelando sincronización... Por favor, esperá."

msgid "Cancelling..."
msgstr "Cancelando..."

msgid "Cannot Reset"
msgstr "No se puede reiniciar"

msgid "Cannot cancel sync: Another tab is currently syncing"
msgstr "No se puede cancelar la sincronización: Otra pestaña está sincronizando actualmente"

msgid "Cannot enable offloading: "
msgstr "No se puede habilitar la descarga: "

#. translators: 1: number of failed files, 2: number of pending files
#, php-format
msgid "Cannot proceed: %1$s failed and %2$s pending files. Please resolve them first."
msgstr "No se puede continuar: hay %1$s archivos fallidos y %2$s pendientes. Resolvelos primero."

msgid "Change bucket"
msgstr "Cambiar bucket"

msgid "Change container"
msgstr "Cambiar contenedor"

msgid "Check now"
msgstr "Comprobar ahora"

msgid "Checking for active synchronization..."
msgstr "Buscando una sincronización activa..."

msgid "Checking sync status..."
msgstr "Comprobando el estado de la sincronización..."

msgid "Checking…"
msgstr "Comprobando…"

msgid "Choose your cloud provider and enter your credentials"
msgstr "Elegí tu proveedor de nube e ingresá tus credenciales"

msgid "Choose your preferred cloud storage provider. Configuration options will appear below."
msgstr "Elegí tu proveedor de almacenamiento en la nube preferido. Las opciones de configuración aparecerán abajo."

msgid "Clear Failed & Enable"
msgstr "Limpiar fallidos y habilitar"

msgid "Clear Failed Files & Enable Offloading"
msgstr "Limpiar archivos fallidos y habilitar descarga"

msgid "Clear List"
msgstr "Limpiar Lista"

msgid "Clearing failed files and enabling offloading"
msgstr "Limpiando archivos fallidos y habilitando descarga"

msgid "Clearing sync data and resetting state..."
msgstr "Borrando los datos de sincronización y reiniciando el estado..."

msgid "Clearing sync data..."
msgstr "Limpiando datos de sincronización..."

msgid "Clearing..."
msgstr "Limpiando..."

msgid "Close"
msgstr "Cerrar"

msgid "Closing this window will cancel the download"
msgstr "Cerrar esta ventana cancelará la descarga"

msgid "Closing this window will cancel the synchronization"
msgstr "Cerrar esta ventana cancelará la sincronización"

msgid "Closing will interrupt the deletion process"
msgstr "Cerrar interrumpirá el proceso de eliminación"

msgid "Cloud Connection Error"
msgstr "Error de conexión con la nube"

msgid "Cloud Permission Denied"
msgstr "La nube denegó el permiso"

msgid "Cloud Provider"
msgstr "Proveedor en la nube"

msgid "Cloud Provider Configuration"
msgstr "Configuración del proveedor en la nube"

msgid "Cloud Provider Configured"
msgstr "Proveedor en la nube configurado"

msgid "Cloud Provider › Connection"
msgstr "Proveedor de nube › Conexión"

msgid "Cloud Provider › Credentials"
msgstr "Proveedor de nube › Credenciales"

msgid "Cloud Provider › Credentials (delete the provider afterwards)"
msgstr "Proveedor de nube › Credenciales (borrar el proveedor después)"

msgid "Cloud Storage Provider"
msgstr "Proveedor de almacenamiento en la nube"

msgid "Cloud Transfer Timed Out"
msgstr "Transferencia a la nube agotó el tiempo de espera"

msgid "Cloud URL Scheme"
msgstr "Esquema de URL de la nube"

msgid "Cloud client not available"
msgstr "El cliente de la nube no está disponible."

msgid "Cloud client not configured"
msgstr "El cliente de la nube no está configurado."

msgid "Cloudflare R2"
msgstr "Cloudflare R2"

msgid "Cloudflare dashboard › R2 › Manage API tokens: a token with Object Read & Write on the bucket. The endpoint is https://<account id>.r2.cloudflarestorage.com; the public URL is the bucket's r2.dev address or your custom domain, with public access enabled on the bucket."
msgstr "Dashboard de Cloudflare › R2 › Manage API tokens: un token con Object Read & Write sobre el bucket. El endpoint es https://<account id>.r2.cloudflarestorage.com; la URL pública es la dirección r2.dev del bucket o tu dominio propio, con el acceso público habilitado en el bucket."

msgid "Compare local files with cloud storage and resynchronize everything from scratch."
msgstr "Comparar archivos locales con el almacenamiento en la nube y resincronizar todo desde cero."

msgid "Complete Sync"
msgstr "Completar sincronización"

msgid "Configuration"
msgstr "Configuración"

msgid "Configure Cloud Provider"
msgstr "Configurar proveedor de nube"

msgid "Configure Now"
msgstr "Configurar ahora"

msgid "Configure cloud storage first"
msgstr "Configurá primero el almacenamiento en la nube"

msgid "Configure how files are uploaded to cloud storage."
msgstr "Configurá cómo se cargan los archivos al almacenamiento en la nube."

msgid "Configure your cloud storage provider"
msgstr "Configurá tu proveedor de almacenamiento en la nube"

msgid "Configured"
msgstr "Configurado"

#. translators: 1: where the files go, 2: number of files synced so far, 3:
#. number pending
#, php-format
msgid "Configured for %1$s. A sync was interrupted: %2$s files done, %3$s pending."
msgstr "Configurado para %1$s. Una sincronización quedó interrumpida: %2$s archivos listos, %3$s pendientes."

#. translators: %s: where the files go
#, php-format
msgid "Configured for %s. Nothing synced yet."
msgstr "Configurado para %s. Todavía no se sincronizó nada."

msgid "Confirm Complete Resync"
msgstr "Confirmar resincronización completa"

msgid "Connect a cloud provider in Cloud Provider › Connection first."
msgstr "Primero conectá un proveedor en Proveedor de nube › Conexión."

msgid "Connect a cloud provider to get started"
msgstr "Conectá un proveedor de nube para comenzar"

msgid "Connect a provider in the Connection tab first. Once one is saved, this is where its key is rotated and where the provider is removed."
msgstr "Primero conectá un proveedor en la solapa Conexión. Una vez guardado, acá se rota su clave y acá se quita el proveedor."

msgid "Connected"
msgstr "Conectado"

msgid "Connected since"
msgstr "Conectado desde"

msgid "Connection"
msgstr "Conexión"

msgid "Connection Failed"
msgstr "La conexión falló."

msgid "Connection Health"
msgstr "Salud de la conexión"

msgid "Connection Successful"
msgstr "Conexión exitosa."

msgid "Connection error"
msgstr "Error de conexión"

msgid "Connection error during download"
msgstr "Error de conexión durante la descarga"

msgid "Connection error while calculating downloads"
msgstr "Error de conexión al calcular las descargas"

msgid "Connection error while cancelling sync"
msgstr "Error de conexión al cancelar la sincronización"

msgid "Connection error while enabling offloading"
msgstr "Error de conexión al habilitar la descarga"

msgid "Connection error while scanning cloud storage"
msgstr "Error de conexión al recorrer el almacenamiento en la nube"

msgid "Connection error while starting download"
msgstr "Error de conexión al iniciar la descarga"

msgid "Connection error while taking control."
msgstr "Error de conexión al tomar el control."

msgid "Connection error. Deletion interrupted."
msgstr "Error de conexión. Eliminación interrumpida."

msgid "Connection error. Please refresh the page."
msgstr "Error de conexión. Recargá la página."

msgid "Connection error. Please try again."
msgstr "Error de conexión. Por favor, intentá de nuevo."

#. translators: 1: seconds until the next attempt, 2: this attempt's number,
#. 3: attempts allowed
#, php-format
msgid "Connection error. Retrying in %1$s s (attempt %2$s of %3$s)..."
msgstr "Error de conexión. Reintentando en %1$s s (intento %2$s de %3$s)..."

msgid "Consecutive failures"
msgstr "Fallos consecutivos"

msgid "Container"
msgstr "Contenedor"

msgid "Container Name"
msgstr "Nombre del contenedor"

msgid "Container Name must contain only lowercase letters, numbers, and hyphens."
msgstr "El Nombre del Contenedor debe contener solo letras minúsculas, números y guiones."

msgid "Container name for storing your media files."
msgstr "Nombre del contenedor donde se guardarán los archivos multimedia."

msgid "Container or Bucket Not Found"
msgstr "No se encontró el contenedor o bucket"

msgid "Continue Here"
msgstr "Continuar acá"

msgid "Continue Sync"
msgstr "Continuar sincronización"

msgid "Continue Upload"
msgstr "Continuar carga"

msgid "Continue and the first sync uploads this site's media next to them: a file with the same name is replaced by this site's, the rest stay, and a later Disconnect would bring them back too. Empty it and only this site's folder is deleted; nothing else in the container or bucket is touched."
msgstr "Si seguís, la primera sincronización sube los medios de este sitio junto a esos archivos: un archivo con el mismo nombre se reemplaza por el de este sitio, el resto queda, y una desconexión posterior también los traería. Si lo vaciás, sólo se borra la carpeta de este sitio; no se toca nada más del contenedor o bucket."

msgid "Continue with these files"
msgstr "Seguir con estos archivos"

msgid "Cool tier (cheaper to store, charged per read)"
msgstr "Nivel Cool (más barato de almacenar, cobra cada lectura)"

msgid "Could not create temp file for cloud download."
msgstr "No se pudo crear el archivo temporal para bajar de la nube."

msgid "Could not instantiate cloud client for the selected provider."
msgstr "No se pudo crear el cliente para el proveedor elegido."

msgid "Could not record the files found in the cloud. Check the database error log and try again."
msgstr "No se pudieron registrar los archivos encontrados en la nube. Revisá el registro de errores de la base de datos e intentalo de nuevo."

msgid "Credentials"
msgstr "Credenciales"

msgid "Credentials do not match tested values. Please test again."
msgstr "Las credenciales no coinciden con los valores probados. Probá la conexión nuevamente."

msgid "Credentials updated."
msgstr "Credenciales actualizadas."

msgid "Credentials were not saved. Try again."
msgstr "No se guardaron las credenciales. Probá de nuevo."

msgid "Credentials: rotate the key, or remove the provider"
msgstr "Credenciales: rotar la clave o quitar el proveedor"

msgid "Current Status"
msgstr "Estado actual"

msgid "Custom (MinIO, Ceph, …)"
