msgstr "Rutas excluidas"

#: includes/class-diluxone-offload-admin.php:1122
msgid "File type not allowed"
msgstr "Tipo de archivo no permitido"

#: includes/class-diluxone-offload-admin.php:1141
#: includes/class-diluxone-offload-admin.php:1806
#: includes/class-diluxone-offload-admin.php:1905
#: includes/class-diluxone-offload-admin.php:1997
#: includes/class-diluxone-offload-admin.php:2097
