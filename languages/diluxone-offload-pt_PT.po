msgid ""
"%1$s files (%2$s) already sit under %3$s in %4$s, where this site's media "
"goes."
msgstr ""
"Já existem %1$s ficheiros (%2$s) em %3$s de %4$s, onde ficam as multimédia "
"deste site."

#. translators: %s: error message
#: includes/class-diluxone-offload-admin.php:912
#, php-format
msgid ""
"What the container or bucket holds could not be checked (%s). The sync can "
"still start; it reports what fails."
msgstr ""
"Não foi possível verificar o que o contentor ou bucket contém (%s). A "
"sincronização pode começar mesmo assim; ela informa o que falhar."

#. translators: %s: number of files left
#: includes/class-diluxone-offload-admin.php:914
#, php-format
msgid "Deleting… %s left."
msgstr "Excluindo… restam %s."

#. translators: %s: number of files deleted
#: includes/class-diluxone-offload-admin.php:916
#, php-format
msgid ""
"Done: %s deleted. The folder is empty; start the sync when you are ready."
msgstr ""
"Pronto: %s excluídos. A pasta está vazia; a sincronização pode começar "
"quando quiser."

#. translators: 1: number of files deleted, 2: number that could not be, 3:
#. the first error
#: includes/class-diluxone-offload-admin.php:918
#, php-format
