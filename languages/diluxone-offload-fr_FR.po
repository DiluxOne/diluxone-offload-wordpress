msgstr "Azure Blob Storage"

#: includes/class-diluxone-offload-admin.php:1271
msgid "No cloud provider is connected. Media is served from this server."
msgstr ""
"Aucun fournisseur cloud n'est connecté. Les médias sont servis depuis ce "
"serveur."

#: includes/class-diluxone-offload-admin.php:1273
msgid "Off"
msgstr "Inactif"

#. translators: 1: short reason for the pause, 2: number of consecutive failures
#: includes/class-diluxone-offload-admin.php:1280
#, php-format
msgid ""
"Paused (%1$s): %2$d consecutive failures. Uploads are refused until the next "
"successful connection."
msgstr ""
"En pause (%1$s) : %2$d échecs consécutifs. Les envois sont refusés jusqu'à "
"la prochaine connexion réussie."

#: includes/class-diluxone-offload-admin.php:1285
#: includes/class-diluxone-offload-admin.php:1338
msgid "Pending"
msgstr "En attente"

#. translators: 1: number of files synced, 2: where they are, 3: number of files that still have a local copy
#: includes/class-diluxone-offload-admin.php:1292
#, php-format
msgid "%1$s files synced to %2$s; %3$s still have a copy on this server."
msgstr ""
"%1$s fichiers synchronisés vers %2$s ; %3$s ont encore une copie sur ce "
"serveur."

#: includes/class-diluxone-offload-admin.php:1298
#: templates/admin-overview.php:203 templates/admin-status-health.php:175
msgid "Active"
msgstr "Actif"

#. translators: 1: number of files synced, 2: where they are
#: includes/class-diluxone-offload-admin.php:1305
#, php-format
msgid ""
"%1$s files synced to %2$s; still served from this server until offloading is "
"enabled."
msgstr ""
"%1$s fichiers synchronisés vers %2$s ; toujours servis depuis ce serveur "
"jusqu'à l'activation du délestage."

#: includes/class-diluxone-offload-admin.php:1310
#: includes/Enums/class-plugin-state.php:55 templates/admin-overview.php:155
#: templates/admin-overview.php:261 templates/admin-sync-sync.php:173
msgid "Synced"
msgstr "Synchronisé"

#: includes/class-diluxone-offload-admin.php:1311
