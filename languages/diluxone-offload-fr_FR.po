msgstr "Étapes pour activer la synchronisation"

#: includes/class-diluxone-offload-admin.php:1166
msgid "Go to Cloud Provider › Connection"
msgstr "Aller à Fournisseur cloud › Connexion"

#: includes/class-diluxone-offload-admin.php:1167
msgid "Configure your cloud storage provider"
msgstr "Configurez votre fournisseur de stockage cloud"

#: includes/class-diluxone-offload-admin.php:1168
msgid "Test the connection"
msgstr "Testez la connexion"

#: includes/class-diluxone-offload-admin.php:1169
msgid "Save your configuration"
msgstr "Enregistrez votre configuration"

#: includes/class-diluxone-offload-admin.php:1170
msgid "Return to this screen to sync files"
msgstr "Revenez sur cet écran pour synchroniser les fichiers"

#. translators: %s: the name of the storage container
#: includes/class-diluxone-offload-admin.php:1265
#, php-format
msgid "the Azure Blob Storage container %s"
msgstr "le conteneur Azure Blob Storage %s"

#: includes/class-diluxone-offload-admin.php:1266
#: templates/admin-provider-connection.php:72
