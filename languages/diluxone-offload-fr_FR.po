msgstr "Azure Blob Storage"

#: includes/class-diluxone-offload-admin.php:1379
msgid "No cloud provider is connected. Media is served from this server."
msgstr ""
"Aucun fournisseur cloud n'est connecté. Les médias sont servis depuis ce "
"serveur."

#: includes/class-diluxone-offload-admin.php:1381
msgid "Off"
msgstr "Inactif"

