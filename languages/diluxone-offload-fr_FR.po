#. translators: 1: files processed, 2: files in all
#, php-format
msgid "%1$s / %2$s files"
msgstr "%1$s / %2$s fichiers"

#. translators: 1: number of files deleted, 2: number that could not be, 3:
#. the first error
#, php-format
msgid "%1$s deleted, %2$s could not be (%3$s). Nothing else was touched; try again, or continue with what is left."
msgstr "%1$s supprimés, %2$s n’ont pas pu l’être (%3$s). Rien d’autre n’a été touché ; réessayez ou continuez avec ce qui reste."

#. translators: 1: number of files, 2: their total size, 3: the folder (e.g.
#. uploads/), 4: the container or bucket
#, php-format
msgid "%1$s file (%2$s) already sits under %3$s in %4$s, where this site's media goes."
msgstr "%1$s fichier (%2$s) se trouve déjà sous %3$s dans %4$s, là où vont les médias de ce site."

#. translators: 1: number of files, 2: how long ago the scan ran
#, php-format
msgid "%1$s file was left out by the last scan (%2$s)."
msgid_plural "%1$s files were left out by the last scan (%2$s)."
msgstr[0] "%1$s fichier a été laissé de côté par la dernière analyse (%2$s)."
msgstr[1] "%1$s fichiers ont été laissés de côté par la dernière analyse (%2$s)."

#. translators: 1: number of files, 2: their total size, 3: the folder (e.g.
#. uploads/), 4: the container or bucket
#, php-format
msgid "%1$s files (%2$s) already sit under %3$s in %4$s, where this site's media goes."
msgstr "%1$s fichiers (%2$s) se trouvent déjà sous %3$s dans %4$s, là où vont les médias de ce site."

#. translators: 1: number of files synced, 2: where they are, 3: number of
#. files that still have a local copy
#, php-format
msgid "%1$s files synced to %2$s; %3$s still have a copy on this server."
msgstr "%1$s fichiers synchronisés vers %2$s ; %3$s ont encore une copie sur ce serveur."

#. translators: 1: number of files synced, 2: where they are
#, php-format
msgid "%1$s files synced to %2$s; still served from this server until offloading is enabled."
msgstr "%1$s fichiers synchronisés vers %2$s ; toujours servis depuis ce serveur jusqu'à l'activation du délestage."

#. translators: 1: files in the cloud, 2: files in the library, 3: percentage
#, php-format
msgid "%1$s of %2$s · %3$s%%"
msgstr "%1$s sur %2$s · %3$s%%"

#. translators: 1: files only in the cloud, 2: files also on this server
#, php-format
msgid "%1$s only in the cloud, %2$s also on this server"
msgstr "%1$s uniquement dans le cloud, %2$s aussi sur ce serveur"

#. translators: 1: plugin name, 2: name of the screen
#, php-format
msgctxt "a dashboard screen title"
msgid "%1$s | %2$s"
msgstr "%1$s | %2$s"

#. translators: 1: what the value is (e.g. "Container"), 2: the value
#, php-format
msgid "%1$s: <strong>%2$s</strong>"
msgstr "%1$s : <strong>%2$s</strong>"

#. translators: %d: number of days
#, php-format
msgid "%d day ago"
msgid_plural "%d days ago"
msgstr[0] "il y a %d jour"
msgstr[1] "il y a %d jours"

#. translators: %d: number of files
#, php-format
msgid "%d file was added since the last sync: it has to be uploaded before offloading is enabled."
msgid_plural "%d files were added since the last sync: they have to be uploaded before offloading is enabled."
msgstr[0] "%d fichier a été ajouté depuis la dernière synchronisation : il doit être envoyé avant d’activer l’offloading."
msgstr[1] "%d fichiers ont été ajoutés depuis la dernière synchronisation : ils doivent être envoyés avant d’activer l’offloading."

#. translators: %d: number of files that failed to sync
#, php-format
msgid "%d files failed to sync"
msgstr "%d fichiers n'ont pas pu être synchronisés"

#. translators: %d: number of hours
#, php-format
msgid "%d hour ago"
msgid_plural "%d hours ago"
msgstr[0] "il y a %d heure"
msgstr[1] "il y a %d heures"

#. translators: %d: number of minutes
#, php-format
msgid "%d minute ago"
msgid_plural "%d minutes ago"
msgstr[0] "il y a %d minute"
msgstr[1] "il y a %d minutes"

#. translators: %s: a human time difference, e.g. "10 minutes"
#, php-format
msgid "%s ago"
msgstr "il y a %s"

#. translators: %s: number of rows in the plugin's tracking table
#, php-format
msgid "%s file tracked"
msgid_plural "%s files tracked"
msgstr[0] "%s fichier suivi"
msgstr[1] "%s fichiers suivis"

msgid "(uploads refused from 3)"
msgstr "(envois refusés à partir de 3)"

msgid "(what a disconnect can bring back)"
msgstr "(ce qu'une déconnexion peut rapatrier)"

msgid "A file that fails is listed with its error and can be retried; the rest of the library is not held back by it."
msgstr "Un fichier en échec est listé avec son erreur et peut être réessayé ; le reste de la bibliothèque n'est pas bloqué par lui."

msgid "A new access key is tested against the same account and container or bucket before it replaces the saved one; the media in the cloud is not touched."
msgstr "Une nouvelle clé d'accès est testée sur le même compte et le même conteneur ou bucket avant de remplacer celle enregistrée ; les médias dans le cloud ne sont pas touchés."

msgid "A previous synchronization was interrupted. You can continue from where it left off or start fresh."
msgstr "Une synchronisation précédente a été interrompue. Vous pouvez reprendre là où elle s'est arrêtée ou recommencer."

msgid "A rotation usually gives a new pair: change it if yours did."
msgstr "Une rotation donne généralement une nouvelle paire de clés : modifiez-la si c'est le cas pour la vôtre."

msgid "A sync has run since, so what is there is this site's media; nothing was deleted."
msgstr "Une synchronisation a eu lieu depuis, ce qui s’y trouve est donc aux médias de ce site ; rien n’a été supprimé."

#. translators: 1: number of files synced so far, 2: number of files pending
#, php-format
msgid "A sync is in progress: %1$s files done, %2$s pending."
msgstr "Une synchronisation est en cours : %1$s fichiers traités, %2$s en attente."

#. translators: %d: the Transfer Timeout setting, in seconds
#, php-format
msgid "A transfer to the cloud took longer than allowed: the Transfer Timeout (%d seconds) for an upload, at least 300 seconds for a download. Raise the setting if this host or its connection is slow; if transfers used to work at this value, check the connection to the provider."
msgstr "Un transfert vers le cloud a dépassé la durée autorisée : le délai de transfert (%d secondes) pour un envoi, au moins 300 secondes pour un téléchargement. Augmentez le réglage si cet hébergement ou sa connexion est lent ; si les transferts fonctionnaient avec cette valeur, vérifiez la connexion au fournisseur."

msgid "ALL sync progress will be discarded (including successfully uploaded files)"
msgstr "TOUTE la progression de synchronisation sera supprimée (y compris les fichiers téléversés avec succès)"

msgid "AWS console › IAM › Users › Security credentials › Create access key, for a user allowed to put, get, delete and list objects in the bucket. The bucket must allow anonymous read of objects (Block Public Access off and a bucket policy granting s3:GetObject); Test Connection checks it."
msgstr "Console AWS › IAM › Users › Security credentials › Create access key, pour un utilisateur autorisé à déposer, récupérer, supprimer et lister les objets du bucket. Le bucket doit autoriser la lecture anonyme des objets (Block Public Access désactivé et une politique de bucket accordant s3:GetObject) ; Tester la connexion le vérifie."

msgid "Accept"
msgstr "Accepter"

msgid "Access Key ID"
msgstr "ID de clé d'accès"

msgid "Account Key"
msgstr "Clé du compte"

msgid "Actions"
msgstr "Actions"

msgid "Activate offloading to serve all media files directly from cloud storage. New uploads will go straight to the cloud, saving local disk space."
msgstr "Activez l'offloading pour servir tous les fichiers médias directement depuis le stockage cloud. Les nouveaux téléversements iront directement vers le cloud, économisant de l'espace disque local."

msgid "Active"
msgstr "Actif"

msgid "Addressing"
msgstr "Adressage"

msgid "Advanced"
msgstr "Avancé"

msgid "Akamai (Linode) Object Storage"
msgstr "Akamai (Linode) Object Storage"

msgid "Akamai Cloud Manager › Object Storage › Access Keys, with read and write in the bucket's region. The region is the first part of the bucket's hostname (for example us-east-1 or us-ord-10). Newer endpoints ignore per-object ACLs: let anyone read the bucket with a bucket policy; Test Connection checks it."
msgstr "Akamai Cloud Manager › Object Storage › Access Keys, avec lecture et écriture dans la région du bucket. La région est la première partie du nom d’hôte du bucket (par exemple us-east-1 ou us-ord-10). Les endpoints récents ignorent les ACL par objet : ouvrez le bucket en lecture avec une bucket policy ; Tester la connexion le vérifie."

#. translators: %d: number of files already synced
#, php-format
msgid "All %d files are synced! Click to scan for any new/modified files and complete the sync process to enable offloading."
msgstr "Les %d fichiers sont tous synchronisés ! Cliquez pour rechercher les fichiers nouveaux/modifiés et terminer le processus de synchronisation afin d'activer l'offloading."

msgid "All files downloaded and offloading disabled"
msgstr "Tous les fichiers téléchargés et offloading désactivé"

msgid "All files have been synced to cloud storage."
msgstr "Tous les fichiers ont été synchronisés vers le stockage cloud."

msgid "All files will be downloaded from cloud to local storage (reverse sync)"
msgstr "Tous les fichiers seront téléchargés du cloud vers le stockage local (synchronisation inverse)"

msgid "All in the cloud only"
msgstr "Tout uniquement dans le cloud"

#. translators: %s: number of files that still have a copy on this server
#, php-format
msgid "All in the cloud · %s still has a copy here"
msgid_plural "All in the cloud · %s still have a copy here"
msgstr[0] "Tout dans le cloud · %s a encore une copie ici"
msgstr[1] "Tout dans le cloud · %s ont encore une copie ici"

msgid "All local files have been deleted."
msgstr "Tous les fichiers locaux ont été supprimés."

msgid "All sync history will be cleared"
msgstr "Tout l'historique de synchronisation sera effacé"

msgid "All your media files have been uploaded to the cloud. You can now enable offloading to serve files directly from cloud storage."
msgstr "Tous vos fichiers médias ont été téléversés vers le cloud. Vous pouvez maintenant activer l'offloading pour servir les fichiers directement depuis le stockage cloud."

msgid "Already local:"
msgstr "Déjà locaux :"

msgid "Already synced files will be detected and skipped"
msgstr "Les fichiers déjà synchronisés seront détectés et ignorés"

msgid "Already uploaded:"
msgstr "Déjà téléversés :"

msgid "Amazon S3"
msgstr "Amazon S3"

msgid "An unexpected error occurred while talking to the cloud provider."
msgstr "Une erreur inattendue s'est produite lors de l'échange avec le fournisseur cloud."

msgid "Analyzing Sync Status"
msgstr "Analyse de l’état de la synchronisation"

msgid "Another browser tab is currently processing the sync."
msgstr "Un autre onglet du navigateur traite la synchronisation."

msgid "Another tab is currently syncing."
msgstr "Un autre onglet est en train de synchroniser."

msgid "Any other server that speaks the S3 API (MinIO, Ceph, …): type the endpoint, the region it expects and the public URL browsers load objects from."
msgstr "Tout autre serveur qui parle l'API S3 (MinIO, Ceph, …) : saisissez l'endpoint, la région qu'il attend et l'URL publique depuis laquelle les navigateurs chargent les objets."

msgid "Applied to every file uploaded from now on. Files already in the cloud keep what they were stored with."
msgstr "S’applique à chaque fichier envoyé à partir de maintenant. Les fichiers déjà dans le cloud gardent ce avec quoi ils ont été stockés."

msgid "Are you sure you want to clear the failed files list?"
msgstr "Êtes-vous sûr de vouloir effacer la liste des fichiers en échec ?"

msgid "Are you sure you want to delete your cloud storage configuration?"
msgstr "Êtes-vous sûr de vouloir supprimer votre configuration de stockage cloud ?"

msgid "Are you sure you want to resynchronize all files?"
msgstr "Êtes-vous sûr de vouloir resynchroniser tous les fichiers ?"

#. translators: %d: number of files that failed to upload
#, php-format
msgid "Attempt to upload the %d failed files again. Successfully uploaded files remain in cloud storage."
msgstr "Tenter de téléverser à nouveau les %d fichiers en échec. Les fichiers téléversés avec succès restent dans le stockage cloud."

msgid "Attempts"
msgstr "Tentatives"

msgid "Audio"
msgstr "Audio"

#. translators: 1: number of files, 2: percentage
#, php-format
msgid "Audio %1$s (%2$s%%)"
msgstr "Audio %1$s (%2$s%%)"

msgid "Awaiting Re-entry"
msgstr "En attente d'une nouvelle saisie"

msgid "Azure Blob Storage"
msgstr "Azure Blob Storage"

msgid "Azure: portal › your storage account › Access keys. The container must allow anonymous read of blobs (public access level Blob); a private container is refused."
msgstr "Azure : portail › votre compte de stockage › Clés d'accès. Le conteneur doit autoriser la lecture anonyme des blobs (niveau d'accès public Blob) ; un conteneur privé est refusé."

msgid "Backblaze B2"
msgstr "Backblaze B2"

msgid "Backblaze › Application Keys: a key with read and write access to the bucket. The region is in the bucket's S3 endpoint (for example us-west-004). The bucket must be public; Test Connection checks it."
msgstr "Backblaze › Application Keys : une clé avec un accès en lecture et en écriture sur le bucket. La région se trouve dans l'endpoint S3 du bucket (par exemple us-west-004). Le bucket doit être public ; Tester la connexion le vérifie."

msgid "Balanced (5 parallel - Recommended)"
msgstr "Équilibré (5 en parallèle - Recommandé)"

msgid "Balanced (5 parallel)"
msgstr "Équilibré (5 en parallèle)"

msgid "Browser caching"
msgstr "Cache du navigateur"

msgid "Browsers and CDNs keep the file instead of asking the storage again: fewer requests, faster pages. The default, public, max-age=604800, is one week. A file you replace under the same name may show its old version for that long."
msgstr "Navigateurs et CDN gardent le fichier au lieu de le redemander au stockage : moins de requêtes, des pages plus rapides. La valeur par défaut, public, max-age=604800, correspond à une semaine. Un fichier remplacé sous le même nom peut afficher son ancienne version pendant ce temps."

msgid "Bucket"
msgstr "Bucket"

msgid "Build"
msgstr "Build"

msgid "Cache directories"
msgstr "Répertoires de cache"

msgid "Cache-Control value"
msgstr "Valeur de Cache-Control"

msgid "Calculating failed files..."
msgstr "Calcul des fichiers en échec..."

msgid "Calculating files to delete..."
msgstr "Calcul des fichiers à supprimer..."

msgid "Calculating files to sync..."
msgstr "Calcul des fichiers à synchroniser..."

msgid "Cancel"
msgstr "Annuler"

msgid "Cancel Download"
msgstr "Annuler le téléchargement"

msgid "Cancel Sync & Reset"
msgstr "Annuler la synchronisation et réinitialiser"

msgid "Cancel sync and return to configured state. This will discard all progress."
msgstr "Annuler la synchronisation et revenir à l'état configuré. Cela supprimera toute la progression."

msgid "Cancel the entire sync process and return to configured state. This will discard ALL progress including successfully uploaded files."
msgstr "Annuler tout le processus de synchronisation et revenir à l'état configuré. Cela supprimera TOUTE la progression, y compris les fichiers téléversés avec succès."

msgid "Cancelling download..."
msgstr "Annulation du téléchargement..."

msgid "Cancelling sync..."
msgstr "Annulation de la synchronisation..."

msgid "Cancelling sync... Please wait."
msgstr "Annulation de la synchronisation... Veuillez patienter."

msgid "Cancelling..."
msgstr "Annulation..."

msgid "Cannot Reset"
msgstr "Réinitialisation impossible"

msgid "Cannot cancel sync: Another tab is currently syncing"
msgstr "Impossible d'annuler la synchronisation : un autre onglet effectue actuellement une synchronisation"

msgid "Cannot enable offloading: "
msgstr "Impossible d'activer l'offloading : "

#. translators: 1: number of failed files, 2: number of pending files
#, php-format
msgid "Cannot proceed: %1$s failed and %2$s pending files. Please resolve them first."
msgstr "Impossible de continuer : %1$s fichiers en échec et %2$s en attente. Résolvez-les d’abord."

msgid "Change bucket"
msgstr "Changer de bucket"

msgid "Change container"
msgstr "Changer de conteneur"

msgid "Check now"
msgstr "Vérifier maintenant"

msgid "Checking for active synchronization..."
msgstr "Recherche d’une synchronisation active..."

msgid "Checking sync status..."
msgstr "Vérification de l’état de la synchronisation..."

msgid "Checking…"
msgstr "Vérification…"

msgid "Choose your cloud provider and enter your credentials"
msgstr "Choisissez votre fournisseur cloud et saisissez vos identifiants"

msgid "Choose your preferred cloud storage provider. Configuration options will appear below."
msgstr "Choisissez votre fournisseur de stockage cloud préféré. Les options de configuration apparaîtront ci-dessous."

msgid "Clear Failed & Enable"
msgstr "Effacer les échecs et activer"

msgid "Clear Failed Files & Enable Offloading"
msgstr "Effacer les fichiers en échec et activer l'offloading"

msgid "Clear List"
msgstr "Effacer la liste"

msgid "Clearing failed files and enabling offloading"
msgstr "Effacement des fichiers en échec et activation de l'offloading"

msgid "Clearing sync data and resetting state..."
msgstr "Effacement des données de synchronisation et réinitialisation de l’état..."

msgid "Clearing sync data..."
msgstr "Effacement des données de synchronisation..."

msgid "Clearing..."
msgstr "Effacement..."

msgid "Close"
msgstr "Fermer"

msgid "Closing this window will cancel the download"
msgstr "Fermer cette fenêtre annulera le téléchargement"

msgid "Closing this window will cancel the synchronization"
msgstr "Fermer cette fenêtre annulera la synchronisation"

msgid "Closing will interrupt the deletion process"
msgstr "Fermer interrompra le processus de suppression"

msgid "Cloud Connection Error"
msgstr "Erreur de connexion au cloud"

msgid "Cloud Permission Denied"
msgstr "Permission refusée par le cloud"

msgid "Cloud Provider"
msgstr "Fournisseur cloud"

msgid "Cloud Provider Configuration"
msgstr "Configuration du fournisseur cloud"

msgid "Cloud Provider Configured"
msgstr "Fournisseur cloud configuré"

msgid "Cloud Provider › Connection"
msgstr "Fournisseur cloud › Connexion"

msgid "Cloud Provider › Credentials"
msgstr "Fournisseur cloud › Identifiants"

msgid "Cloud Provider › Credentials (delete the provider afterwards)"
msgstr "Fournisseur cloud › Identifiants (supprimer le fournisseur ensuite)"

msgid "Cloud Storage Provider"
msgstr "Fournisseur de stockage cloud"

msgid "Cloud Transfer Timed Out"
msgstr "Transfert vers le cloud expiré"

msgid "Cloud URL Scheme"
msgstr "Schéma d'URL du cloud"

msgid "Cloud client not available"
msgstr "Client cloud indisponible."

msgid "Cloud client not configured"
msgstr "Client cloud non configuré."

msgid "Cloudflare R2"
msgstr "Cloudflare R2"

msgid "Cloudflare dashboard › R2 › Manage API tokens: a token with Object Read & Write on the bucket. The endpoint is https://<account id>.r2.cloudflarestorage.com; the public URL is the bucket's r2.dev address or your custom domain, with public access enabled on the bucket."
msgstr "Tableau de bord Cloudflare › R2 › Manage API tokens : un jeton avec Object Read & Write sur le bucket. L'endpoint est https://<account id>.r2.cloudflarestorage.com ; l'URL publique est l'adresse r2.dev du bucket ou votre domaine personnalisé, avec l'accès public activé sur le bucket."

msgid "Compare local files with cloud storage and resynchronize everything from scratch."
msgstr "Comparer les fichiers locaux avec le stockage cloud et tout resynchroniser depuis le début."

msgid "Complete Sync"
msgstr "Terminer la synchronisation"

msgid "Configuration"
msgstr "Configuration"

msgid "Configure Cloud Provider"
msgstr "Configurer le fournisseur cloud"

msgid "Configure Now"
msgstr "Configurer maintenant"

msgid "Configure cloud storage first"
msgstr "Configurez d'abord le stockage cloud"

msgid "Configure how files are uploaded to cloud storage."
msgstr "Configurez la façon dont les fichiers sont téléversés vers le cloud."

msgid "Configure your cloud storage provider"
msgstr "Configurez votre fournisseur de stockage cloud"

msgid "Configured"
msgstr "Configuré"

#. translators: 1: where the files go, 2: number of files synced so far, 3:
#. number pending
#, php-format
msgid "Configured for %1$s. A sync was interrupted: %2$s files done, %3$s pending."
msgstr "Configuré pour %1$s. Une synchronisation a été interrompue : %2$s fichiers traités, %3$s en attente."

#. translators: %s: where the files go
#, php-format
msgid "Configured for %s. Nothing synced yet."
msgstr "Configuré pour %s. Rien n'est encore synchronisé."

msgid "Confirm Complete Resync"
msgstr "Confirmer la resynchronisation complète"

msgid "Connect a cloud provider in Cloud Provider › Connection first."
msgstr "Connectez d'abord un fournisseur dans Fournisseur cloud › Connexion."

msgid "Connect a cloud provider to get started"
msgstr "Connectez un fournisseur cloud pour commencer"

msgid "Connect a provider in the Connection tab first. Once one is saved, this is where its key is rotated and where the provider is removed."
msgstr "Connectez d'abord un fournisseur dans l'onglet Connexion. Une fois enregistré, c'est ici que sa clé se change et que le fournisseur se retire."

msgid "Connected"
msgstr "Connecté"

msgid "Connected since"
msgstr "Connecté depuis"

msgid "Connection"
msgstr "Connexion"

msgid "Connection Failed"
msgstr "Échec de la connexion."

msgid "Connection Health"
msgstr "Santé de la connexion"

msgid "Connection Successful"
msgstr "Connexion réussie."

msgid "Connection error"
msgstr "Erreur de connexion"

msgid "Connection error during download"
msgstr "Erreur de connexion pendant le téléchargement"

msgid "Connection error while calculating downloads"
msgstr "Erreur de connexion lors du calcul des téléchargements"

msgid "Connection error while cancelling sync"
msgstr "Erreur de connexion lors de l'annulation de la synchronisation"

msgid "Connection error while enabling offloading"
msgstr "Erreur de connexion lors de l'activation de l'offloading"

msgid "Connection error while scanning cloud storage"
msgstr "Erreur de connexion lors du parcours du stockage cloud"

msgid "Connection error while starting download"
msgstr "Erreur de connexion au lancement du téléchargement"

msgid "Connection error while taking control."
msgstr "Erreur de connexion lors de la prise de contrôle."

msgid "Connection error. Deletion interrupted."
msgstr "Erreur de connexion. Suppression interrompue."

msgid "Connection error. Please refresh the page."
msgstr "Erreur de connexion. Rechargez la page."

msgid "Connection error. Please try again."
msgstr "Erreur de connexion. Veuillez réessayer."

#. translators: 1: seconds until the next attempt, 2: this attempt's number,
#. 3: attempts allowed
#, php-format
msgid "Connection error. Retrying in %1$s s (attempt %2$s of %3$s)..."
msgstr "Erreur de connexion. Nouvel essai dans %1$s s (tentative %2$s sur %3$s)..."

msgid "Consecutive failures"
msgstr "Échecs consécutifs"

msgid "Container"
msgstr "Conteneur"

msgid "Container Name"
msgstr "Nom du conteneur"

msgid "Container Name must contain only lowercase letters, numbers, and hyphens."
msgstr "Le nom du conteneur ne doit contenir que des lettres minuscules, des chiffres et des traits d'union."

msgid "Container name for storing your media files."
msgstr "Nom du conteneur dans lequel stocker vos fichiers médias."

msgid "Container or Bucket Not Found"
msgstr "Conteneur ou bucket introuvable"

msgid "Continue Here"
msgstr "Continuer ici"

msgid "Continue Sync"
msgstr "Poursuivre la synchronisation"

msgid "Continue Upload"
msgstr "Poursuivre le téléversement"

msgid "Continue and the first sync uploads this site's media next to them: a file with the same name is replaced by this site's, the rest stay, and a later Disconnect would bring them back too. Empty it and only this site's folder is deleted; nothing else in the container or bucket is touched."
msgstr "En continuant, la première synchronisation envoie les médias de ce site à côté de ces fichiers : un fichier du même nom est remplacé par celui de ce site, le reste demeure, et une déconnexion ultérieure le ramènerait aussi. En le vidant, seul le dossier de ce site est supprimé ; rien d’autre du conteneur ou du bucket n’est touché."

msgid "Continue with these files"
msgstr "Continuer avec ces fichiers"

msgid "Cool tier (cheaper to store, charged per read)"
msgstr "Niveau Cool (moins cher à stocker, chaque lecture est facturée)"

msgid "Could not create temp file for cloud download."
msgstr "Impossible de créer le fichier temporaire pour le téléchargement depuis le cloud."

msgid "Could not instantiate cloud client for the selected provider."
msgstr "Impossible de créer le client pour le fournisseur sélectionné."

msgid "Could not record the files found in the cloud. Check the database error log and try again."
msgstr "Impossible d'enregistrer les fichiers trouvés dans le cloud. Consultez le journal des erreurs de la base de données et réessayez."

msgid "Credentials"
msgstr "Identifiants"

msgid "Credentials do not match tested values. Please test again."
msgstr "Les identifiants ne correspondent pas aux valeurs testées. Veuillez tester à nouveau."

msgid "Credentials updated."
msgstr "Identifiants mis à jour."

