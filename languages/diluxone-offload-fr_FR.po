msgid "Updating the access key will temporarily interrupt file operations while testing the new connection. Current uploads/downloads may fail."
msgstr "La mise à jour de la clé d'accès interrompra temporairement les opérations sur les fichiers pendant le test de la nouvelle connexion. Les téléversements/téléchargements en cours peuvent échouer."

msgid "Upload Directory"
msgstr "Répertoire de téléversement"

