msgstr "o bucket %2$s do %1$s"

#. translators: %s: the name of the storage container
#: includes/class-diluxone-offload-admin.php:1313
#, php-format
msgid "the Azure Blob Storage container %s"
msgstr "o contêiner do Azure Blob Storage %s"

#: includes/class-diluxone-offload-admin.php:1314
#: templates/admin-provider-connection.php:76
msgid "Azure Blob Storage"
msgstr "Azure Blob Storage"

#: includes/class-diluxone-offload-admin.php:1320
msgid "No cloud provider is connected. Media is served from this server."
msgstr ""
"Nenhum provedor de nuvem está conectado. A mídia é servida a partir deste "
"servidor."

#: includes/class-diluxone-offload-admin.php:1322
msgid "Off"
msgstr "Desligado"

#. translators: 1: short reason for the pause, 2: number of consecutive failures
#: includes/class-diluxone-offload-admin.php:1329
#, php-format
msgid ""
"Paused (%1$s): %2$d consecutive failures. Uploads are refused until the next "
"successful connection."
msgstr ""
"Em pausa (%1$s): %2$d falhas consecutivas. Os uploads são recusados até a "
"próxima conexão bem-sucedida."

#: includes/class-diluxone-offload-admin.php:1334
#: includes/class-diluxone-offload-admin.php:1387
msgid "Pending"
msgstr "Pendente"

#. translators: 1: number of files synced, 2: where they are, 3: number of files that still have a local copy
#: includes/class-diluxone-offload-admin.php:1341
#, php-format
msgid "%1$s files synced to %2$s; %3$s still have a copy on this server."
msgstr ""
"%1$s arquivos sincronizados em %2$s; %3$s ainda têm uma cópia neste servidor."

#: includes/class-diluxone-offload-admin.php:1347
#: templates/admin-overview.php:202 templates/admin-status-health.php:175
msgid "Active"
msgstr "Ativo"

#. translators: 1: number of files synced, 2: where they are
#: includes/class-diluxone-offload-admin.php:1354
#, php-format
msgid ""
"%1$s files synced to %2$s; still served from this server until offloading is "
"enabled."
msgstr ""
"%1$s arquivos sincronizados em %2$s; ainda servidos a partir deste servidor "
"até que o offloading seja ativado."

#: includes/class-diluxone-offload-admin.php:1359
#: includes/Enums/class-plugin-state.php:55 templates/admin-overview.php:154
#: templates/admin-sync-sync.php:175
msgid "Synced"
msgstr "Sincronizado"

#: includes/class-diluxone-offload-admin.php:1360
