#. Plugin Name of the plugin
#: diluxone-offload.php
msgid "DiluxOne Offload – Media Storage"
msgstr "DiluxOne Offload – Media Storage"

#. Plugin URI of the plugin
#: diluxone-offload.php
msgid "https://github.com/DiluxOne/diluxone-offload-wordpress"
msgstr "https://github.com/DiluxOne/diluxone-offload-wordpress"

#. Description of the plugin
#: diluxone-offload.php
msgid ""
"Move your WordPress media to cloud object storage and serve it from there. "
"Replaces /uploads/ transparently via a PHP stream wrapper."
msgstr ""
"Mova sua mídia do WordPress para um armazenamento de objetos na nuvem e "
"sirva os arquivos de lá. Substitui /uploads/ de forma transparente via um "
"stream wrapper do PHP."

