#. translators: 1: files processed, 2: files in all
#, php-format
msgid "%1$s / %2$s files"
msgstr "%1$s / %2$s arquivos"

#. translators: 1: number of files deleted, 2: number that could not be, 3:
#. the first error
#, php-format
msgid "%1$s deleted, %2$s could not be (%3$s). Nothing else was touched; try again, or continue with what is left."
msgstr "%1$s excluídos, %2$s não puderam ser excluídos (%3$s). Nada mais foi alterado; tente de novo ou continue com o que restou."

#. translators: 1: number of files, 2: their total size, 3: the folder (e.g.
#. uploads/), 4: the container or bucket
#, php-format
msgid "%1$s file (%2$s) already sits under %3$s in %4$s, where this site's media goes."
msgstr "Já existe %1$s arquivo (%2$s) em %3$s de %4$s, onde ficam as mídias deste site."

#. translators: 1: number of files, 2: how long ago the scan ran
#, php-format
msgid "%1$s file was left out by the last scan (%2$s)."
msgid_plural "%1$s files were left out by the last scan (%2$s)."
msgstr[0] "%1$s arquivo ficou de fora na última varredura (%2$s)."
msgstr[1] "%1$s arquivos ficaram de fora na última varredura (%2$s)."

#. translators: 1: number of files, 2: their total size, 3: the folder (e.g.
#. uploads/), 4: the container or bucket
#, php-format
msgid "%1$s files (%2$s) already sit under %3$s in %4$s, where this site's media goes."
msgstr "Já existem %1$s arquivos (%2$s) em %3$s de %4$s, onde ficam as mídias deste site."

#. translators: 1: number of files synced, 2: where they are, 3: number of
#. files that still have a local copy
#, php-format
msgid "%1$s files synced to %2$s; %3$s still have a copy on this server."
msgstr "%1$s arquivos sincronizados em %2$s; %3$s ainda têm uma cópia neste servidor."

#. translators: 1: number of files synced, 2: where they are
#, php-format
msgid "%1$s files synced to %2$s; still served from this server until offloading is enabled."
msgstr "%1$s arquivos sincronizados em %2$s; ainda servidos a partir deste servidor até que o offloading seja ativado."

#. translators: 1: files in the cloud, 2: files in the library, 3: percentage
#, php-format
msgid "%1$s of %2$s · %3$s%%"
msgstr "%1$s de %2$s · %3$s%%"

#. translators: 1: files only in the cloud, 2: files also on this server
#, php-format
msgid "%1$s only in the cloud, %2$s also on this server"
msgstr "%1$s somente na nuvem, %2$s também neste servidor"

#. translators: 1: plugin name, 2: name of the screen
#, php-format
msgctxt "a dashboard screen title"
msgid "%1$s | %2$s"
msgstr "%1$s | %2$s"

#. translators: 1: what the value is (e.g. "Container"), 2: the value
#, php-format
msgid "%1$s: <strong>%2$s</strong>"
msgstr "%1$s: <strong>%2$s</strong>"

#. translators: %d: number of days
#, php-format
msgid "%d day ago"
msgid_plural "%d days ago"
msgstr[0] "%d dia atrás"
msgstr[1] "%d dias atrás"

#. translators: %d: number of files
#, php-format
msgid "%d file was added since the last sync: it has to be uploaded before offloading is enabled."
msgid_plural "%d files were added since the last sync: they have to be uploaded before offloading is enabled."
msgstr[0] "%d arquivo foi adicionado desde a última sincronização: ele precisa ser enviado antes de ativar o offloading."
msgstr[1] "%d arquivos foram adicionados desde a última sincronização: eles precisam ser enviados antes de ativar o offloading."

#. translators: %d: number of files that failed to sync
#, php-format
msgid "%d files failed to sync"
msgstr "%d arquivos falharam ao sincronizar"

#. translators: %d: number of hours
#, php-format
msgid "%d hour ago"
msgid_plural "%d hours ago"
msgstr[0] "%d hora atrás"
msgstr[1] "%d horas atrás"

#. translators: %d: number of minutes
#, php-format
msgid "%d minute ago"
msgid_plural "%d minutes ago"
msgstr[0] "%d minuto atrás"
msgstr[1] "%d minutos atrás"

#. translators: %s: a human time difference, e.g. "10 minutes"
#, php-format
msgid "%s ago"
msgstr "há %s"

#. translators: %s: number of rows in the plugin's tracking table
#, php-format
msgid "%s file tracked"
msgid_plural "%s files tracked"
msgstr[0] "%s arquivo rastreado"
msgstr[1] "%s arquivos rastreados"

msgid "(uploads refused from 3)"
msgstr "(uploads recusados a partir de 3)"

msgid "(what a disconnect can bring back)"
msgstr "(o que uma desconexão pode trazer de volta)"

msgid "A file that fails is listed with its error and can be retried; the rest of the library is not held back by it."
msgstr "Um arquivo que falha é listado com seu erro e pode ser tentado novamente; o restante da biblioteca não fica parado por causa dele."

msgid "A new access key is tested against the same account and container or bucket before it replaces the saved one; the media in the cloud is not touched."
msgstr "Uma nova chave de acesso é testada na mesma conta e no mesmo contêiner ou bucket antes de substituir a salva; a mídia na nuvem não é tocada."

msgid "A previous synchronization was interrupted. You can continue from where it left off or start fresh."
msgstr "Uma sincronização anterior foi interrompida. Você pode continuar de onde parou ou recomeçar do zero."

msgid "A rotation usually gives a new pair: change it if yours did."
msgstr "Uma rotação geralmente gera um novo par: altere-o se o seu mudou."

msgid "A sync has run since, so what is there is this site's media; nothing was deleted."
msgstr "Já houve uma sincronização, então o que está lá são mídias deste site; nada foi excluído."

#. translators: 1: number of files synced so far, 2: number of files pending
#, php-format
msgid "A sync is in progress: %1$s files done, %2$s pending."
msgstr "Há uma sincronização em andamento: %1$s arquivos prontos, %2$s pendentes."

#. translators: %d: the Transfer Timeout setting, in seconds
#, php-format
msgid "A transfer to the cloud took longer than allowed: the Transfer Timeout (%d seconds) for an upload, at least 300 seconds for a download. Raise the setting if this host or its connection is slow; if transfers used to work at this value, check the connection to the provider."
msgstr "Uma transferência para a nuvem demorou mais do que o permitido: o tempo limite de transferência (%d segundos) para um upload, pelo menos 300 segundos para um download. Aumente a configuração se este servidor ou sua conexão forem lentos; se as transferências funcionavam com este valor, verifique a conexão com o provedor."

msgid "ALL sync progress will be discarded (including successfully uploaded files)"
msgstr "TODO o progresso será descartado (inclusive os arquivos enviados com sucesso)"

msgid "AWS console › IAM › Users › Security credentials › Create access key, for a user allowed to put, get, delete and list objects in the bucket. The bucket must allow anonymous read of objects (Block Public Access off and a bucket policy granting s3:GetObject); Test Connection checks it."
msgstr "Console da AWS › IAM › Users › Security credentials › Create access key, para um usuário com permissão para enviar, obter, excluir e listar objetos no bucket. O bucket precisa permitir leitura anônima dos objetos (Block Public Access desativado e uma política de bucket concedendo s3:GetObject); o Testar conexão verifica isso."

msgid "Accept"
msgstr "Aceitar"

msgid "Access Key ID"
msgstr "ID da chave de acesso"

msgid "Account Key"
msgstr "Chave da conta"

msgid "Actions"
msgstr "Ações"

msgid "Activate offloading to serve all media files directly from cloud storage. New uploads will go straight to the cloud, saving local disk space."
msgstr "Ative o offloading para servir todos os arquivos de mídia diretamente da nuvem. Os novos uploads irão direto para a nuvem, economizando espaço em disco."

msgid "Active"
msgstr "Ativo"

msgid "Addressing"
msgstr "Endereçamento"

msgid "Advanced"
msgstr "Avançado"

msgid "Akamai (Linode) Object Storage"
msgstr "Akamai (Linode) Object Storage"

msgid "Akamai Cloud Manager › Object Storage › Access Keys, with read and write in the bucket's region. The region is the first part of the bucket's hostname (for example us-east-1 or us-ord-10). Newer endpoints ignore per-object ACLs: let anyone read the bucket with a bucket policy; Test Connection checks it."
msgstr "Akamai Cloud Manager › Object Storage › Access Keys, com leitura e escrita na região do bucket. A região é a primeira parte do hostname do bucket (por exemplo us-east-1 ou us-ord-10). Os endpoints mais novos ignoram ACLs por objeto: permita que qualquer pessoa leia o bucket com uma bucket policy; o Testar conexão verifica isso."

#. translators: %d: number of files already synced
#, php-format
msgid "All %d files are synced! Click to scan for any new/modified files and complete the sync process to enable offloading."
msgstr "Todos os %d arquivos foram sincronizados! Clique para procurar arquivos novos/modificados e concluir o processo para habilitar o offloading."

msgid "All files downloaded and offloading disabled"
msgstr "Todos os arquivos baixados e offloading desabilitado"

msgid "All files have been synced to cloud storage."
msgstr "Todos os arquivos foram sincronizados com o armazenamento na nuvem."

msgid "All files will be downloaded from cloud to local storage (reverse sync)"
msgstr "Todos os arquivos serão baixados da nuvem para o armazenamento local (ressincronização inversa)"

msgid "All in the cloud only"
msgstr "Tudo somente na nuvem"

#. translators: %s: number of files that still have a copy on this server
#, php-format
msgid "All in the cloud · %s still has a copy here"
msgid_plural "All in the cloud · %s still have a copy here"
msgstr[0] "Tudo na nuvem · %s ainda tem uma cópia aqui"
msgstr[1] "Tudo na nuvem · %s ainda têm uma cópia aqui"

msgid "All local files have been deleted."
msgstr "Todos os arquivos locais foram excluídos."

msgid "All sync history will be cleared"
msgstr "Todo o histórico de sincronização será apagado"

msgid "All your media files have been uploaded to the cloud. You can now enable offloading to serve files directly from cloud storage."
msgstr "Todos os seus arquivos de mídia foram enviados para a nuvem. Agora você pode habilitar o offloading para servi-los diretamente da nuvem."

msgid "Already local:"
msgstr "Já locais:"

msgid "Already synced files will be detected and skipped"
msgstr "Os arquivos já sincronizados serão detectados e ignorados"

msgid "Already uploaded:"
msgstr "Já enviados:"

msgid "Amazon S3"
msgstr "Amazon S3"

msgid "An unexpected error occurred while talking to the cloud provider."
msgstr "Ocorreu um erro inesperado ao falar com o provedor."

msgid "Analyzing Sync Status"
msgstr "Analisando o status da sincronização"

msgid "Another browser tab is currently processing the sync."
msgstr "Outra aba do navegador está processando a sincronização."

msgid "Another tab is currently syncing."
msgstr "Outra aba está sincronizando."

msgid "Any other server that speaks the S3 API (MinIO, Ceph, …): type the endpoint, the region it expects and the public URL browsers load objects from."
msgstr "Qualquer outro servidor que fale a API do S3 (MinIO, Ceph, …): informe o endpoint, a região que ele espera e a URL pública de onde os navegadores carregam os objetos."

msgid "Applied to every file uploaded from now on. Files already in the cloud keep what they were stored with."
msgstr "Aplica-se a cada arquivo enviado daqui em diante. Os arquivos que já estão na nuvem mantêm o que tinham ao ser armazenados."

msgid "Are you sure you want to clear the failed files list?"
msgstr "Tem certeza de que deseja limpar a lista de arquivos com falha?"

msgid "Are you sure you want to delete your cloud storage configuration?"
msgstr "Tem certeza de que deseja excluir sua configuração de armazenamento na nuvem?"

msgid "Are you sure you want to resynchronize all files?"
msgstr "Tem certeza de que deseja ressincronizar todos os arquivos?"

#. translators: %d: number of files that failed to upload
#, php-format
msgid "Attempt to upload the %d failed files again. Successfully uploaded files remain in cloud storage."
msgstr "Tenta enviar novamente os %d arquivos com falha. Os arquivos já enviados permanecem na nuvem."

msgid "Attempts"
msgstr "Tentativas"

msgid "Audio"
msgstr "Áudio"

#. translators: 1: number of files, 2: percentage
#, php-format
msgid "Audio %1$s (%2$s%%)"
msgstr "Áudio %1$s (%2$s%%)"

msgid "Awaiting Re-entry"
msgstr "Aguardando novo preenchimento"

msgid "Azure Blob Storage"
msgstr "Azure Blob Storage"

msgid "Azure: portal › your storage account › Access keys. The container must allow anonymous read of blobs (public access level Blob); a private container is refused."
msgstr "Azure: portal › sua conta de armazenamento › Chaves de acesso. O contêiner precisa permitir leitura anônima de blobs (nível de acesso público Blob); um contêiner privado é recusado."

msgid "Backblaze B2"
msgstr "Backblaze B2"

msgid "Backblaze › Application Keys: a key with read and write access to the bucket. The region is in the bucket's S3 endpoint (for example us-west-004). The bucket must be public; Test Connection checks it."
msgstr "Backblaze › Application Keys: uma chave com acesso de leitura e gravação ao bucket. A região está no endpoint S3 do bucket (por exemplo, us-west-004). O bucket precisa ser público; o Testar conexão verifica isso."

msgid "Balanced (5 parallel - Recommended)"
msgstr "Balanceado (5 em paralelo — recomendado)"

msgid "Balanced (5 parallel)"
msgstr "Balanceado (5 em paralelo)"

msgid "Browser caching"
msgstr "Cache do navegador"

msgid "Browsers and CDNs keep the file instead of asking the storage again: fewer requests, faster pages. The default, public, max-age=604800, is one week. A file you replace under the same name may show its old version for that long."
msgstr "Navegadores e CDNs guardam o arquivo em vez de pedi-lo de novo ao armazenamento: menos pedidos, páginas mais rápidas. O padrão, public, max-age=604800, é uma semana. Um arquivo substituído com o mesmo nome pode mostrar a versão anterior durante esse tempo."

msgid "Bucket"
msgstr "Bucket"

msgid "Build"
msgstr "Build"

msgid "Cache directories"
msgstr "Diretórios de cache"

msgid "Cache-Control value"
msgstr "Valor do Cache-Control"

msgid "Calculating failed files..."
msgstr "Calculando os arquivos com falha..."

msgid "Calculating files to delete..."
msgstr "Calculando arquivos a excluir…"

msgid "Calculating files to sync..."
msgstr "Calculando os arquivos a sincronizar..."

msgid "Cancel"
msgstr "Cancelar"

msgid "Cancel Download"
msgstr "Cancelar download"

msgid "Cancel Sync & Reset"
msgstr "Cancelar e redefinir sincronização"

msgid "Cancel sync and return to configured state. This will discard all progress."
msgstr "Cancela a sincronização e volta ao estado configurado. Isso descarta todo o progresso."

msgid "Cancel the entire sync process and return to configured state. This will discard ALL progress including successfully uploaded files."
msgstr "Cancela todo o processo de sincronização e volta ao estado configurado. Isso descartará TODO o progresso, incluindo arquivos já enviados."

msgid "Cancelling download..."
msgstr "Cancelando download…"

msgid "Cancelling sync..."
msgstr "Cancelando sincronização…"

msgid "Cancelling sync... Please wait."
msgstr "Cancelando sincronização… Aguarde."

msgid "Cancelling..."
msgstr "Cancelando…"

msgid "Cannot Reset"
msgstr "Não é possível redefinir"

msgid "Cannot cancel sync: Another tab is currently syncing"
msgstr "Não é possível cancelar: outra aba está sincronizando."

msgid "Cannot enable offloading: "
msgstr "Não é possível habilitar o offloading: "

#. translators: 1: number of failed files, 2: number of pending files
#, php-format
msgid "Cannot proceed: %1$s failed and %2$s pending files. Please resolve them first."
msgstr "Não é possível continuar: %1$s arquivos com falha e %2$s pendentes. Resolva-os primeiro."

msgid "Change bucket"
msgstr "Trocar bucket"

msgid "Change container"
msgstr "Trocar contêiner"

msgid "Check now"
msgstr "Verificar agora"

msgid "Checking for active synchronization..."
msgstr "Verificando se há uma sincronização ativa..."

msgid "Checking sync status..."
msgstr "Verificando o status da sincronização..."

msgid "Checking…"
msgstr "Verificando…"

msgid "Choose your cloud provider and enter your credentials"
msgstr "Escolha seu provedor na nuvem e informe suas credenciais"

msgid "Choose your preferred cloud storage provider. Configuration options will appear below."
msgstr "Escolha seu provedor de armazenamento preferido. As opções de configuração aparecerão abaixo."

msgid "Clear Failed & Enable"
msgstr "Limpar falhas e habilitar"

msgid "Clear Failed Files & Enable Offloading"
msgstr "Limpar arquivos com falha e habilitar offloading"

msgid "Clear List"
msgstr "Limpar lista"

msgid "Clearing failed files and enabling offloading"
msgstr "Limpando arquivos com falha e habilitando offloading"

msgid "Clearing sync data and resetting state..."
msgstr "Limpando os dados de sincronização e redefinindo o estado..."

msgid "Clearing sync data..."
msgstr "Limpando dados de sincronização…"

msgid "Clearing..."
msgstr "Limpando…"

msgid "Close"
msgstr "Fechar"

msgid "Closing this window will cancel the download"
msgstr "Fechar esta janela cancelará o download"

msgid "Closing this window will cancel the synchronization"
msgstr "Fechar esta janela cancelará a sincronização"

msgid "Closing will interrupt the deletion process"
msgstr "Fechar interromperá o processo de exclusão"

msgid "Cloud Connection Error"
msgstr "Erro de conexão com a nuvem"

msgid "Cloud Permission Denied"
msgstr "A nuvem negou a permissão"

msgid "Cloud Provider"
msgstr "Provedor na nuvem"

msgid "Cloud Provider Configuration"
msgstr "Configuração do provedor na nuvem"

msgid "Cloud Provider Configured"
msgstr "Provedor na nuvem configurado"

msgid "Cloud Provider › Connection"
msgstr "Provedor de nuvem › Conexão"

msgid "Cloud Provider › Credentials"
msgstr "Provedor de nuvem › Credenciais"

msgid "Cloud Provider › Credentials (delete the provider afterwards)"
msgstr "Provedor de nuvem › Credenciais (excluir o provedor depois)"

msgid "Cloud Storage Provider"
msgstr "Provedor de armazenamento na nuvem"

msgid "Cloud Transfer Timed Out"
msgstr "Transferência para a nuvem expirou"

msgid "Cloud URL Scheme"
msgstr "Esquema de URL da nuvem"

msgid "Cloud client not available"
msgstr "Cliente da nuvem indisponível."

msgid "Cloud client not configured"
msgstr "Cliente da nuvem não configurado."

msgid "Cloudflare R2"
msgstr "Cloudflare R2"

msgid "Cloudflare dashboard › R2 › Manage API tokens: a token with Object Read & Write on the bucket. The endpoint is https://<account id>.r2.cloudflarestorage.com; the public URL is the bucket's r2.dev address or your custom domain, with public access enabled on the bucket."
msgstr "Painel da Cloudflare › R2 › Manage API tokens: um token com Object Read & Write no bucket. O endpoint é https://<account id>.r2.cloudflarestorage.com; a URL pública é o endereço r2.dev do bucket ou seu domínio personalizado, com o acesso público habilitado no bucket."

msgid "Compare local files with cloud storage and resynchronize everything from scratch."
msgstr "Compara os arquivos locais com a nuvem e ressincroniza tudo do zero."

msgid "Complete Sync"
msgstr "Concluir sincronização"

msgid "Configuration"
msgstr "Configuração"

msgid "Configure Cloud Provider"
msgstr "Configurar provedor na nuvem"

msgid "Configure Now"
msgstr "Configurar agora"

msgid "Configure cloud storage first"
msgstr "Configure primeiro o armazenamento na nuvem"

msgid "Configure how files are uploaded to cloud storage."
msgstr "Configure como os arquivos são enviados para o armazenamento na nuvem."

msgid "Configure your cloud storage provider"
msgstr "Configure seu provedor de armazenamento na nuvem"

msgid "Configured"
msgstr "Configurado"

#. translators: 1: where the files go, 2: number of files synced so far, 3:
#. number pending
#, php-format
msgid "Configured for %1$s. A sync was interrupted: %2$s files done, %3$s pending."
msgstr "Configurado para %1$s. Uma sincronização foi interrompida: %2$s arquivos prontos, %3$s pendentes."

#. translators: %s: where the files go
#, php-format
msgid "Configured for %s. Nothing synced yet."
msgstr "Configurado para %s. Nada foi sincronizado ainda."

msgid "Confirm Complete Resync"
msgstr "Confirmar ressincronização completa"

msgid "Connect a cloud provider in Cloud Provider › Connection first."
msgstr "Primeiro conecte um provedor em Provedor de nuvem › Conexão."

msgid "Connect a cloud provider to get started"
msgstr "Conecte um provedor na nuvem para começar"

msgid "Connect a provider in the Connection tab first. Once one is saved, this is where its key is rotated and where the provider is removed."
msgstr "Primeiro conecte um provedor na aba Conexão. Depois de salvo, é aqui que a chave é rotacionada e que o provedor é removido."

msgid "Connected"
msgstr "Conectado"

msgid "Connected since"
msgstr "Conectado desde"

msgid "Connection"
msgstr "Conexão"

msgid "Connection Failed"
msgstr "Falha na conexão"

msgid "Connection Health"
msgstr "Saúde da conexão"

msgid "Connection Successful"
msgstr "Conexão bem-sucedida"

msgid "Connection error"
msgstr "Erro de conexão"

msgid "Connection error during download"
msgstr "Erro de conexão durante o download"

msgid "Connection error while calculating downloads"
msgstr "Erro de conexão ao calcular os downloads"

msgid "Connection error while cancelling sync"
msgstr "Erro de conexão ao cancelar a sincronização"

msgid "Connection error while enabling offloading"
msgstr "Erro de conexão ao habilitar o offloading"

msgid "Connection error while scanning cloud storage"
msgstr "Erro de conexão ao percorrer o armazenamento em nuvem"

msgid "Connection error while starting download"
msgstr "Erro de conexão ao iniciar o download"

msgid "Connection error while taking control."
msgstr "Erro de conexão ao assumir o controle."

msgid "Connection error. Deletion interrupted."
msgstr "Erro de conexão. Exclusão interrompida."

msgid "Connection error. Please refresh the page."
msgstr "Erro de conexão. Recarregue a página."

msgid "Connection error. Please try again."
msgstr "Erro de conexão. Tente novamente."

#. translators: 1: seconds until the next attempt, 2: this attempt's number,
#. 3: attempts allowed
#, php-format
msgid "Connection error. Retrying in %1$s s (attempt %2$s of %3$s)..."
msgstr "Erro de conexão. Tentando novamente em %1$s s (tentativa %2$s de %3$s)..."

msgid "Consecutive failures"
msgstr "Falhas consecutivas"

msgid "Container"
msgstr "Contêiner"

msgid "Container Name"
msgstr "Nome do contêiner"

msgid "Container Name must contain only lowercase letters, numbers, and hyphens."
msgstr "O nome do contêiner deve conter apenas letras minúsculas, números e hifens."

msgid "Container name for storing your media files."
msgstr "Nome do contêiner onde os arquivos de mídia serão armazenados."

msgid "Container or Bucket Not Found"
msgstr "Contêiner ou bucket não encontrado"

msgid "Continue Here"
msgstr "Continuar aqui"

msgid "Continue Sync"
msgstr "Continuar sincronização"

msgid "Continue Upload"
msgstr "Continuar upload"

msgid "Continue and the first sync uploads this site's media next to them: a file with the same name is replaced by this site's, the rest stay, and a later Disconnect would bring them back too. Empty it and only this site's folder is deleted; nothing else in the container or bucket is touched."
msgstr "Ao continuar, a primeira sincronização envia as mídias deste site junto com esses arquivos: um arquivo com o mesmo nome é substituído pelo deste site, o resto permanece, e uma desconexão posterior também os traria. Ao esvaziar, só a pasta deste site é excluída; nada mais do contêiner ou bucket é alterado."

msgid "Continue with these files"
msgstr "Continuar com estes arquivos"

msgid "Cool tier (cheaper to store, charged per read)"
msgstr "Camada Cool (mais barata para armazenar, cobra cada leitura)"

msgid "Could not create temp file for cloud download."
msgstr "Não foi possível criar o arquivo temporário para baixar da nuvem."

msgid "Could not instantiate cloud client for the selected provider."
msgstr "Não foi possível criar o cliente para o provedor escolhido."

msgid "Could not record the files found in the cloud. Check the database error log and try again."
msgstr "Não foi possível registrar os arquivos encontrados na nuvem. Verifique o log de erros do banco de dados e tente novamente."

msgid "Credentials"
msgstr "Credenciais"

msgid "Credentials do not match tested values. Please test again."
msgstr "As credenciais não correspondem aos valores testados. Teste a conexão novamente."

msgid "Credentials updated."
msgstr "Credenciais atualizadas."

msgid "Credentials were not saved. Try again."
msgstr "As credenciais não foram salvas. Tente de novo."

msgid "Credentials: rotate the key, or remove the provider"
