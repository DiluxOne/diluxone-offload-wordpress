msgstr "Offloading wird für zukünftige Uploads aktiviert"

#: templates/admin-sync-sync.php:600
msgid "Yes, Clear & Enable"
msgstr "Ja, löschen & aktivieren"

#: templates/admin-sync-sync.php:607
