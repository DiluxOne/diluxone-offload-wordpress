msgstr "Dateityp nicht erlaubt"

#: includes/class-diluxone-offload-admin.php:1153
#: includes/class-diluxone-offload-admin.php:1819
#: includes/class-diluxone-offload-admin.php:1918
#: includes/class-diluxone-offload-admin.php:2010
#: includes/class-diluxone-offload-admin.php:2110
#: includes/class-diluxone-offload-admin.php:2185
