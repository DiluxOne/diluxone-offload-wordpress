msgstr "Aktiv"

#. translators: 1: number of files synced, 2: where they are
#: includes/class-diluxone-offload-admin.php:1413
#, php-format
msgid ""
"%1$s files synced to %2$s; still served from this server until offloading is"
" enabled."
msgstr ""
"%1$s Dateien nach %2$s synchronisiert; sie werden weiter von diesem Server "
"ausgeliefert, bis Offloading aktiviert ist."

#: includes/class-diluxone-offload-admin.php:1418
#: includes/Enums/class-plugin-state.php:55 templates/admin-overview.php:155
#: templates/admin-sync-sync.php:138
