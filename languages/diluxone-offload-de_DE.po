#: includes/class-diluxone-offload-admin.php:1170
#, php-format
msgid ""
"Paused (%1$s): %2$d consecutive failures. Uploads are refused until the next "
"successful connection."
msgstr ""
"Pausiert (%1$s): %2$d aufeinanderfolgende Fehler. Uploads werden bis zur "
"nächsten erfolgreichen Verbindung abgewiesen."

#: includes/class-diluxone-offload-admin.php:1175
#: includes/class-diluxone-offload-admin.php:1228
msgid "Pending"
msgstr "Ausstehend"

#. translators: 1: number of files synced, 2: where they are, 3: number of files that still have a local copy
#: includes/class-diluxone-offload-admin.php:1182
