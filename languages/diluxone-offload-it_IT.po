msgstr ""
"Impossibile annullare la sincronizzazione: un'altra scheda sta sincronizzando"

#: includes/class-diluxone-offload-admin.php:2005
msgid "Sync cancelled successfully"
msgstr "Sincronizzazione annullata correttamente"

#: includes/class-diluxone-offload-admin.php:2027
