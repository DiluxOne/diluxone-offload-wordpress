#. translators: 1: files processed, 2: files in all
#, php-format
msgid "%1$s / %2$s files"
msgstr "%1$s / %2$s file"

#. translators: 1: number of files deleted, 2: number that could not be, 3:
#. the first error
#, php-format
msgid "%1$s deleted, %2$s could not be (%3$s). Nothing else was touched; try again, or continue with what is left."
msgstr "%1$s eliminati, %2$s non è stato possibile eliminarli (%3$s). Nient’altro è stato toccato; riprova o continua con ciò che resta."

#. translators: 1: number of files, 2: their total size, 3: the folder (e.g.
#. uploads/), 4: the container or bucket
#, php-format
msgid "%1$s file (%2$s) already sits under %3$s in %4$s, where this site's media goes."
msgstr "C’è già %1$s file (%2$s) in %3$s di %4$s, dove vanno i media di questo sito."

#. translators: 1: number of files, 2: how long ago the scan ran
#, php-format
msgid "%1$s file was left out by the last scan (%2$s)."
msgid_plural "%1$s files were left out by the last scan (%2$s)."
msgstr[0] "%1$s file è stato lasciato fuori dall'ultima scansione (%2$s)."
msgstr[1] "%1$s file sono stati lasciati fuori dall'ultima scansione (%2$s)."

#. translators: 1: number of files, 2: their total size, 3: the folder (e.g.
#. uploads/), 4: the container or bucket
#, php-format
msgid "%1$s files (%2$s) already sit under %3$s in %4$s, where this site's media goes."
msgstr "Ci sono già %1$s file (%2$s) in %3$s di %4$s, dove vanno i media di questo sito."

#. translators: 1: number of files synced, 2: where they are, 3: number of
#. files that still have a local copy
#, php-format
msgid "%1$s files synced to %2$s; %3$s still have a copy on this server."
msgstr "%1$s file sincronizzati su %2$s; %3$s hanno ancora una copia su questo server."

#. translators: 1: number of files synced, 2: where they are
#, php-format
msgid "%1$s files synced to %2$s; still served from this server until offloading is enabled."
msgstr "%1$s file sincronizzati su %2$s; ancora serviti da questo server finché l'offloading non viene attivato."

#. translators: 1: files in the cloud, 2: files in the library, 3: percentage
#, php-format
msgid "%1$s of %2$s · %3$s%%"
msgstr "%1$s di %2$s · %3$s%%"

#. translators: 1: files only in the cloud, 2: files also on this server
#, php-format
msgid "%1$s only in the cloud, %2$s also on this server"
msgstr "%1$s solo nel cloud, %2$s anche su questo server"

#. translators: 1: plugin name, 2: name of the screen
#, php-format
msgctxt "a dashboard screen title"
msgid "%1$s | %2$s"
msgstr "%1$s | %2$s"

#. translators: 1: what the value is (e.g. "Container"), 2: the value
#, php-format
msgid "%1$s: <strong>%2$s</strong>"
msgstr "%1$s: <strong>%2$s</strong>"

#. translators: %d: number of days
#, php-format
msgid "%d day ago"
msgid_plural "%d days ago"
msgstr[0] "%d giorno fa"
msgstr[1] "%d giorni fa"

#. translators: %d: number of files
#, php-format
msgid "%d file was added since the last sync: it has to be uploaded before offloading is enabled."
msgid_plural "%d files were added since the last sync: they have to be uploaded before offloading is enabled."
msgstr[0] "%d file è stato aggiunto dall’ultima sincronizzazione: va caricato prima di attivare l’offloading."
msgstr[1] "%d file sono stati aggiunti dall’ultima sincronizzazione: vanno caricati prima di attivare l’offloading."

#. translators: %d: number of files that failed to sync
#, php-format
msgid "%d files failed to sync"
msgstr "%d file non sono stati sincronizzati"

#. translators: %d: number of hours
#, php-format
msgid "%d hour ago"
msgid_plural "%d hours ago"
msgstr[0] "%d ora fa"
msgstr[1] "%d ore fa"

#. translators: %d: number of minutes
#, php-format
msgid "%d minute ago"
msgid_plural "%d minutes ago"
msgstr[0] "%d minuto fa"
msgstr[1] "%d minuti fa"

#. translators: %s: a human time difference, e.g. "10 minutes"
#, php-format
msgid "%s ago"
msgstr "%s fa"

#. translators: %s: number of rows in the plugin's tracking table
#, php-format
msgid "%s file tracked"
msgid_plural "%s files tracked"
msgstr[0] "%s file tracciato"
msgstr[1] "%s file tracciati"

msgid "(uploads refused from 3)"
msgstr "(caricamenti rifiutati da 3)"

msgid "(what a disconnect can bring back)"
msgstr "(quanto una disconnessione può riportare)"

msgid "A file that fails is listed with its error and can be retried; the rest of the library is not held back by it."
msgstr "Un file che fallisce viene elencato con il suo errore e può essere ritentato; il resto della libreria non viene trattenuto da esso."

msgid "A new access key is tested against the same account and container or bucket before it replaces the saved one; the media in the cloud is not touched."
msgstr "Una nuova chiave di accesso viene provata sullo stesso account e container o bucket prima di sostituire quella salvata; i media nel cloud non vengono toccati."

msgid "A previous synchronization was interrupted. You can continue from where it left off or start fresh."
msgstr "Una sincronizzazione precedente è stata interrotta. Puoi riprendere da dove si era fermata o ricominciare da capo."

msgid "A rotation usually gives a new pair: change it if yours did."
msgstr "Una rotazione genera di solito una nuova coppia: cambiala se è successo anche alla tua."

msgid "A sync has run since, so what is there is this site's media; nothing was deleted."
msgstr "Nel frattempo c’è stata una sincronizzazione, quindi ciò che c’è sono i media di questo sito; non è stato eliminato nulla."

#. translators: 1: number of files synced so far, 2: number of files pending
#, php-format
msgid "A sync is in progress: %1$s files done, %2$s pending."
msgstr "Una sincronizzazione è in corso: %1$s file completati, %2$s in attesa."

#. translators: %d: the Transfer Timeout setting, in seconds
#, php-format
msgid "A transfer to the cloud took longer than allowed: the Transfer Timeout (%d seconds) for an upload, at least 300 seconds for a download. Raise the setting if this host or its connection is slow; if transfers used to work at this value, check the connection to the provider."
msgstr "Un trasferimento verso il cloud ha superato il tempo consentito: il timeout di trasferimento (%d secondi) per un caricamento, almeno 300 secondi per un download. Aumenta l'impostazione se questo host o la sua connessione sono lenti; se i trasferimenti funzionavano con questo valore, controlla la connessione al provider."

msgid "ALL sync progress will be discarded (including successfully uploaded files)"
msgstr "TUTTO il progresso di sincronizzazione verrà scartato (compresi i file caricati con successo)"

msgid "AWS console › IAM › Users › Security credentials › Create access key, for a user allowed to put, get, delete and list objects in the bucket. The bucket must allow anonymous read of objects (Block Public Access off and a bucket policy granting s3:GetObject); Test Connection checks it."
msgstr "Console AWS › IAM › Utenti › Credenziali di sicurezza › Crea chiave di accesso, per un utente autorizzato a caricare, leggere, eliminare ed elencare gli oggetti nel bucket. Il bucket deve consentire la lettura anonima degli oggetti (Block Public Access disattivato e una bucket policy che concede s3:GetObject); Verifica connessione lo controlla."

msgid "Accept"
msgstr "Accetta"

msgid "Access Key ID"
msgstr "ID chiave di accesso"

msgid "Account Key"
msgstr "Chiave dell'account"

msgid "Actions"
msgstr "Azioni"

msgid "Activate offloading to serve all media files directly from cloud storage. New uploads will go straight to the cloud, saving local disk space."
msgstr "Attiva l'offloading per servire tutti i file multimediali direttamente dallo storage cloud. I nuovi caricamenti andranno direttamente nel cloud, risparmiando spazio su disco locale."

msgid "Active"
msgstr "Attivo"

msgid "Addressing"
msgstr "Indirizzamento"

msgid "Advanced"
msgstr "Avanzate"

msgid "Akamai (Linode) Object Storage"
msgstr "Akamai (Linode) Object Storage"

msgid "Akamai Cloud Manager › Object Storage › Access Keys, with read and write in the bucket's region. The region is the first part of the bucket's hostname (for example us-east-1 or us-ord-10). Newer endpoints ignore per-object ACLs: let anyone read the bucket with a bucket policy; Test Connection checks it."
msgstr "Akamai Cloud Manager › Object Storage › Access Keys, con lettura e scrittura nella regione del bucket. La regione è la prima parte del nome host del bucket (ad esempio us-east-1 o us-ord-10). Gli endpoint più recenti ignorano le ACL per oggetto: rendi il bucket leggibile con una bucket policy; Verifica connessione lo verifica."

#. translators: %d: number of files already synced
#, php-format
msgid "All %d files are synced! Click to scan for any new/modified files and complete the sync process to enable offloading."
msgstr "Tutti i %d file sono sincronizzati! Fai clic per cercare eventuali file nuovi/modificati e completare il processo di sincronizzazione per abilitare l'offloading."

msgid "All files downloaded and offloading disabled"
msgstr "Tutti i file scaricati e offloading disabilitato"

msgid "All files have been synced to cloud storage."
msgstr "Tutti i file sono stati sincronizzati nello storage cloud."

msgid "All files will be downloaded from cloud to local storage (reverse sync)"
msgstr "Tutti i file verranno scaricati dal cloud allo storage locale (sincronizzazione inversa)"

msgid "All in the cloud only"
msgstr "Tutto solo nel cloud"

#. translators: %s: number of files that still have a copy on this server
#, php-format
msgid "All in the cloud · %s still has a copy here"
msgid_plural "All in the cloud · %s still have a copy here"
msgstr[0] "Tutto nel cloud · %s ha ancora una copia qui"
msgstr[1] "Tutto nel cloud · %s hanno ancora una copia qui"

msgid "All local files have been deleted."
msgstr "Tutti i file locali sono stati eliminati."

msgid "All sync history will be cleared"
msgstr "Tutta la cronologia di sincronizzazione verrà cancellata"

msgid "All your media files have been uploaded to the cloud. You can now enable offloading to serve files directly from cloud storage."
msgstr "Tutti i tuoi file multimediali sono stati caricati nel cloud. Ora puoi abilitare l'offloading per servire i file direttamente dallo storage cloud."

msgid "Already local:"
msgstr "Già locali:"

msgid "Already synced files will be detected and skipped"
msgstr "I file già sincronizzati verranno rilevati e saltati"

msgid "Already uploaded:"
msgstr "Già caricati:"

msgid "Amazon S3"
msgstr "Amazon S3"

msgid "An unexpected error occurred while talking to the cloud provider."
msgstr "Si è verificato un errore imprevisto nella comunicazione con il provider cloud."

msgid "Analyzing Sync Status"
msgstr "Analisi dello stato della sincronizzazione"

msgid "Another browser tab is currently processing the sync."
msgstr "Un’altra scheda del browser sta elaborando la sincronizzazione."

msgid "Another tab is currently syncing."
msgstr "Un’altra scheda sta sincronizzando."

msgid "Any other server that speaks the S3 API (MinIO, Ceph, …): type the endpoint, the region it expects and the public URL browsers load objects from."
msgstr "Qualsiasi altro server che parla l'API S3 (MinIO, Ceph, …): digita l'endpoint, la regione che si aspetta e l'URL pubblico da cui i browser caricano gli oggetti."

msgid "Applied to every file uploaded from now on. Files already in the cloud keep what they were stored with."
msgstr "Si applica a ogni file caricato da ora in poi. I file già nel cloud mantengono ciò con cui sono stati salvati."

msgid "Are you sure you want to clear the failed files list?"
msgstr "Vuoi davvero cancellare l'elenco dei file non riusciti?"

msgid "Are you sure you want to delete your cloud storage configuration?"
msgstr "Vuoi davvero eliminare la tua configurazione di storage cloud?"

msgid "Are you sure you want to resynchronize all files?"
msgstr "Vuoi davvero risincronizzare tutti i file?"

#. translators: %d: number of files that failed to upload
#, php-format
msgid "Attempt to upload the %d failed files again. Successfully uploaded files remain in cloud storage."
msgstr "Tenta di caricare nuovamente gli %d file non riusciti. I file caricati con successo rimangono nello storage cloud."

msgid "Attempts"
msgstr "Tentativi"

msgid "Audio"
msgstr "Audio"

#. translators: 1: number of files, 2: percentage
#, php-format
msgid "Audio %1$s (%2$s%%)"
msgstr "Audio %1$s (%2$s%%)"

msgid "Awaiting Re-entry"
msgstr "In attesa di un nuovo inserimento"

msgid "Azure Blob Storage"
msgstr "Azure Blob Storage"

msgid "Azure: portal › your storage account › Access keys. The container must allow anonymous read of blobs (public access level Blob); a private container is refused."
msgstr "Azure: portale › il tuo account di archiviazione › Chiavi di accesso. Il container deve consentire la lettura anonima dei blob (livello di accesso pubblico Blob); un container privato viene rifiutato."

msgid "Backblaze B2"
msgstr "Backblaze B2"

msgid "Backblaze › Application Keys: a key with read and write access to the bucket. The region is in the bucket's S3 endpoint (for example us-west-004). The bucket must be public; Test Connection checks it."
msgstr "Backblaze › Chiavi applicazione: una chiave con accesso in lettura e scrittura al bucket. La regione si trova nell'endpoint S3 del bucket (per esempio us-west-004). Il bucket deve essere pubblico; Verifica connessione lo controlla."

msgid "Balanced (5 parallel - Recommended)"
msgstr "Bilanciato (5 in parallelo – consigliato)"

msgid "Balanced (5 parallel)"
msgstr "Bilanciato (5 in parallelo)"

msgid "Browser caching"
msgstr "Cache del browser"

msgid "Browsers and CDNs keep the file instead of asking the storage again: fewer requests, faster pages. The default, public, max-age=604800, is one week. A file you replace under the same name may show its old version for that long."
msgstr "Browser e CDN conservano il file invece di richiederlo di nuovo allo storage: meno richieste, pagine più veloci. Il valore predefinito, public, max-age=604800, è una settimana. Un file sostituito con lo stesso nome può mostrare la versione precedente per quel tempo."

msgid "Bucket"
msgstr "Bucket"

msgid "Build"
msgstr "Build"

msgid "Cache directories"
msgstr "Directory di cache"

msgid "Cache-Control value"
msgstr "Valore di Cache-Control"

msgid "Calculating failed files..."
msgstr "Calcolo dei file non riusciti..."

msgid "Calculating files to delete..."
msgstr "Calcolo dei file da eliminare..."

msgid "Calculating files to sync..."
msgstr "Calcolo dei file da sincronizzare..."

msgid "Cancel"
msgstr "Annulla"

msgid "Cancel Download"
msgstr "Annulla download"

msgid "Cancel Sync & Reset"
msgstr "Annulla sincronizzazione e reimposta"

msgid "Cancel sync and return to configured state. This will discard all progress."
msgstr "Annulla la sincronizzazione e torna allo stato configurato. Questa operazione scarterà tutto il progresso."

msgid "Cancel the entire sync process and return to configured state. This will discard ALL progress including successfully uploaded files."
msgstr "Annulla l'intero processo di sincronizzazione e torna allo stato configurato. Questa operazione scarterà TUTTO il progresso, inclusi i file caricati con successo."

msgid "Cancelling download..."
msgstr "Annullamento del download..."

msgid "Cancelling sync..."
msgstr "Annullamento della sincronizzazione..."

msgid "Cancelling sync... Please wait."
msgstr "Annullamento della sincronizzazione... Attendi."

msgid "Cancelling..."
msgstr "Annullamento in corso..."

msgid "Cannot Reset"
msgstr "Impossibile reimpostare"

msgid "Cannot cancel sync: Another tab is currently syncing"
msgstr "Impossibile annullare la sincronizzazione: un'altra scheda sta sincronizzando"

msgid "Cannot enable offloading: "
msgstr "Impossibile abilitare l'offloading: "

#. translators: 1: number of failed files, 2: number of pending files
#, php-format
msgid "Cannot proceed: %1$s failed and %2$s pending files. Please resolve them first."
msgstr "Impossibile procedere: %1$s file non riusciti e %2$s in attesa. Risolvili prima."

msgid "Change bucket"
msgstr "Cambia bucket"

msgid "Change container"
msgstr "Cambia container"

msgid "Check now"
msgstr "Controlla ora"

msgid "Checking for active synchronization..."
msgstr "Ricerca di una sincronizzazione attiva..."

msgid "Checking sync status..."
msgstr "Verifica dello stato della sincronizzazione..."

msgid "Checking…"
msgstr "Controllo…"

msgid "Choose your cloud provider and enter your credentials"
msgstr "Scegli il tuo provider cloud e inserisci le tue credenziali"

msgid "Choose your preferred cloud storage provider. Configuration options will appear below."
msgstr "Scegli il tuo provider di storage cloud preferito. Le opzioni di configurazione appariranno di seguito."

msgid "Clear Failed & Enable"
msgstr "Cancella errori e abilita"

msgid "Clear Failed Files & Enable Offloading"
msgstr "Cancella file non riusciti e abilita offloading"

msgid "Clear List"
msgstr "Cancella elenco"

msgid "Clearing failed files and enabling offloading"
msgstr "Cancellazione dei file non riusciti e abilitazione dell'offloading"

msgid "Clearing sync data and resetting state..."
msgstr "Cancellazione dei dati di sincronizzazione e reimpostazione dello stato..."

msgid "Clearing sync data..."
msgstr "Cancellazione dei dati di sincronizzazione..."

msgid "Clearing..."
msgstr "Cancellazione..."

msgid "Close"
msgstr "Chiudi"

msgid "Closing this window will cancel the download"
msgstr "Chiudere questa finestra annullerà il download"

msgid "Closing this window will cancel the synchronization"
msgstr "Chiudere questa finestra annullerà la sincronizzazione"

msgid "Closing will interrupt the deletion process"
msgstr "La chiusura interromperà il processo di eliminazione"

msgid "Cloud Connection Error"
msgstr "Errore di connessione al cloud"

msgid "Cloud Permission Denied"
msgstr "Permesso negato dal cloud"

msgid "Cloud Provider"
msgstr "Provider cloud"

msgid "Cloud Provider Configuration"
msgstr "Configurazione del provider cloud"

msgid "Cloud Provider Configured"
msgstr "Provider cloud configurato"

msgid "Cloud Provider › Connection"
msgstr "Provider cloud › Connessione"

msgid "Cloud Provider › Credentials"
msgstr "Provider cloud › Credenziali"

msgid "Cloud Provider › Credentials (delete the provider afterwards)"
msgstr "Provider cloud › Credenziali (eliminare il provider dopo)"

msgid "Cloud Storage Provider"
msgstr "Provider di storage cloud"

msgid "Cloud Transfer Timed Out"
msgstr "Trasferimento cloud scaduto"

msgid "Cloud URL Scheme"
msgstr "Schema URL del cloud"

msgid "Cloud client not available"
msgstr "Client cloud non disponibile."

msgid "Cloud client not configured"
msgstr "Client cloud non configurato."

msgid "Cloudflare R2"
msgstr "Cloudflare R2"

msgid "Cloudflare dashboard › R2 › Manage API tokens: a token with Object Read & Write on the bucket. The endpoint is https://<account id>.r2.cloudflarestorage.com; the public URL is the bucket's r2.dev address or your custom domain, with public access enabled on the bucket."
msgstr "Dashboard Cloudflare › R2 › Gestisci token API: un token con permessi Object Read & Write sul bucket. L'endpoint è https://<account id>.r2.cloudflarestorage.com; l'URL pubblico è l'indirizzo r2.dev del bucket o il tuo dominio personalizzato, con l'accesso pubblico abilitato sul bucket."

msgid "Compare local files with cloud storage and resynchronize everything from scratch."
msgstr "Confronta i file locali con lo storage cloud e risincronizza tutto da capo."

msgid "Complete Sync"
msgstr "Completa sincronizzazione"

msgid "Configuration"
msgstr "Configurazione"

msgid "Configure Cloud Provider"
msgstr "Configura provider cloud"

msgid "Configure Now"
msgstr "Configura ora"

msgid "Configure cloud storage first"
msgstr "Configura prima lo storage cloud"

msgid "Configure how files are uploaded to cloud storage."
msgstr "Configura come i file vengono caricati sullo storage cloud."

msgid "Configure your cloud storage provider"
msgstr "Configura il tuo provider di storage cloud"

msgid "Configured"
msgstr "Configurato"

#. translators: 1: where the files go, 2: number of files synced so far, 3:
#. number pending
#, php-format
msgid "Configured for %1$s. A sync was interrupted: %2$s files done, %3$s pending."
msgstr "Configurato per %1$s. Una sincronizzazione è stata interrotta: %2$s file completati, %3$s in attesa."

#. translators: %s: where the files go
#, php-format
msgid "Configured for %s. Nothing synced yet."
msgstr "Configurato per %s. Non è ancora stato sincronizzato nulla."

msgid "Confirm Complete Resync"
msgstr "Conferma risincronizzazione completa"

msgid "Connect a cloud provider in Cloud Provider › Connection first."
msgstr "Prima collega un provider in Provider cloud › Connessione."

msgid "Connect a cloud provider to get started"
msgstr "Connetti un provider cloud per iniziare"

msgid "Connect a provider in the Connection tab first. Once one is saved, this is where its key is rotated and where the provider is removed."
msgstr "Prima collega un provider nella scheda Connessione. Una volta salvato, qui si ruota la sua chiave e qui si rimuove il provider."

msgid "Connected"
msgstr "Connesso"

msgid "Connected since"
msgstr "Connesso dal"

msgid "Connection"
msgstr "Connessione"

msgid "Connection Failed"
msgstr "Connessione non riuscita."

msgid "Connection Health"
msgstr "Stato della connessione"

msgid "Connection Successful"
msgstr "Connessione riuscita."

msgid "Connection error"
msgstr "Errore di connessione"

msgid "Connection error during download"
msgstr "Errore di connessione durante il download"

msgid "Connection error while calculating downloads"
msgstr "Errore di connessione durante il calcolo dei download"

msgid "Connection error while cancelling sync"
msgstr "Errore di connessione durante l'annullamento della sincronizzazione"

msgid "Connection error while enabling offloading"
msgstr "Errore di connessione durante l'abilitazione dell'offloading"

msgid "Connection error while scanning cloud storage"
msgstr "Errore di connessione durante l’esame dello storage cloud"

msgid "Connection error while starting download"
msgstr "Errore di connessione all’avvio del download"

msgid "Connection error while taking control."
msgstr "Errore di connessione durante la presa di controllo."

msgid "Connection error. Deletion interrupted."
msgstr "Errore di connessione. Eliminazione interrotta."

msgid "Connection error. Please refresh the page."
msgstr "Errore di connessione. Ricarica la pagina."

msgid "Connection error. Please try again."
msgstr "Errore di connessione. Riprova."

#. translators: 1: seconds until the next attempt, 2: this attempt's number,
#. 3: attempts allowed
#, php-format
msgid "Connection error. Retrying in %1$s s (attempt %2$s of %3$s)..."
msgstr "Errore di connessione. Nuovo tentativo tra %1$s s (tentativo %2$s di %3$s)..."

msgid "Consecutive failures"
msgstr "Errori consecutivi"

msgid "Container"
msgstr "Container"

msgid "Container Name"
msgstr "Nome del container"

msgid "Container Name must contain only lowercase letters, numbers, and hyphens."
msgstr "Il nome del container deve contenere solo lettere minuscole, numeri e trattini."

msgid "Container name for storing your media files."
msgstr "Nome del container in cui memorizzare i tuoi file multimediali."

msgid "Container or Bucket Not Found"
msgstr "Contenitore o bucket non trovato"

msgid "Continue Here"
msgstr "Continua qui"

msgid "Continue Sync"
msgstr "Continua sincronizzazione"

msgid "Continue Upload"
msgstr "Continua caricamento"

msgid "Continue and the first sync uploads this site's media next to them: a file with the same name is replaced by this site's, the rest stay, and a later Disconnect would bring them back too. Empty it and only this site's folder is deleted; nothing else in the container or bucket is touched."
msgstr "Continuando, la prima sincronizzazione carica i media di questo sito accanto a quei file: un file con lo stesso nome viene sostituito da quello di questo sito, il resto rimane, e una disconnessione successiva riporterebbe anche quelli. Svuotandolo, viene eliminata solo la cartella di questo sito; nient’altro del contenitore o bucket viene toccato."

msgid "Continue with these files"
msgstr "Continua con questi file"

msgid "Cool tier (cheaper to store, charged per read)"
msgstr "Livello Cool (più economico da conservare, ogni lettura è addebitata)"

msgid "Could not create temp file for cloud download."
msgstr "Impossibile creare il file temporaneo per lo scaricamento dal cloud."

msgid "Could not instantiate cloud client for the selected provider."
msgstr "Impossibile creare il client per il provider selezionato."

msgid "Could not record the files found in the cloud. Check the database error log and try again."
msgstr "Impossibile registrare i file trovati nel cloud. Controlla il log degli errori del database e riprova."

msgid "Credentials"
msgstr "Credenziali"

msgid "Credentials do not match tested values. Please test again."
msgstr "Le credenziali non corrispondono ai valori testati. Esegui nuovamente il test."

msgid "Credentials updated."
msgstr "Credenziali aggiornate."

msgid "Credentials were not saved. Try again."
msgstr "Le credenziali non sono state salvate. Riprova."

msgid "Credentials: rotate the key, or remove the provider"
msgstr "Credenziali: ruotare la chiave o rimuovere il provider"

msgid "Current Status"
msgstr "Stato attuale"

msgid "Custom (MinIO, Ceph, …)"
msgstr "Personalizzato (MinIO, Ceph, …)"

msgid "DB Schema Version"
