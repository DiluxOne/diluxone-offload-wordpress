#, php-format
msgid ""
"Attempt to upload the %d failed files again. Successfully uploaded files "
"remain in cloud storage."
msgstr ""
"Tenta di caricare nuovamente gli %d file non riusciti. I file caricati con "
"successo rimangono nello storage cloud."

