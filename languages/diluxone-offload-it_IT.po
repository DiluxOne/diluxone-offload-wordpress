msgstr "Passaggi per abilitare la sincronizzazione"

#: includes/class-diluxone-offload-admin.php:1214
msgid "Go to Cloud Provider › Connection"
msgstr "Vai a Provider cloud › Connessione"

#: includes/class-diluxone-offload-admin.php:1215
msgid "Configure your cloud storage provider"
msgstr "Configura il tuo provider di storage cloud"

#: includes/class-diluxone-offload-admin.php:1216
msgid "Test the connection"
msgstr "Verifica la connessione"

#: includes/class-diluxone-offload-admin.php:1217
msgid "Save your configuration"
msgstr "Salva la tua configurazione"

#: includes/class-diluxone-offload-admin.php:1218
