msgstr "il container Azure Blob Storage %s"

#: includes/class-diluxone-offload-admin.php:1326
#: templates/admin-provider-connection.php:76
msgid "Azure Blob Storage"
msgstr "Azure Blob Storage"

#: includes/class-diluxone-offload-admin.php:1332
msgid "No cloud provider is connected. Media is served from this server."
msgstr ""
"Nessun provider cloud è collegato. I media sono serviti da questo server."

#: includes/class-diluxone-offload-admin.php:1334
msgid "Off"
msgstr "Spento"

#. translators: 1: short reason for the pause, 2: number of consecutive
#. failures
#: includes/class-diluxone-offload-admin.php:1341
#, php-format
msgid ""
"Paused (%1$s): %2$d consecutive failures. Uploads are refused until the next"
" successful connection."
msgstr ""
"In pausa (%1$s): %2$d errori consecutivi. I caricamenti vengono rifiutati "
"fino alla prossima connessione riuscita."

#: includes/class-diluxone-offload-admin.php:1346
#: includes/class-diluxone-offload-admin.php:1399
msgid "Pending"
msgstr "In attesa"

#. translators: 1: number of files synced, 2: where they are, 3: number of
#. files that still have a local copy
#: includes/class-diluxone-offload-admin.php:1353
#, php-format
msgid "%1$s files synced to %2$s; %3$s still have a copy on this server."
msgstr ""
"%1$s file sincronizzati su %2$s; %3$s hanno ancora una copia su questo "
"server."

#: includes/class-diluxone-offload-admin.php:1359
#: templates/admin-overview.php:202 templates/admin-status-health.php:130
msgid "Active"
msgstr "Attivo"

#. translators: 1: number of files synced, 2: where they are
#: includes/class-diluxone-offload-admin.php:1366
#, php-format
msgid ""
"%1$s files synced to %2$s; still served from this server until offloading is"
" enabled."
msgstr ""
"%1$s file sincronizzati su %2$s; ancora serviti da questo server finché "
"l'offloading non viene attivato."

#: includes/class-diluxone-offload-admin.php:1371
#: includes/Enums/class-plugin-state.php:55 templates/admin-overview.php:154
#: templates/admin-sync-sync.php:175
msgid "Synced"
msgstr "Sincronizzato"

#: includes/class-diluxone-offload-admin.php:1372
